# docker-compose (db 서비스)
MARIADB_DATABASE=project
MARIADB_USER=project
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root
DB_PORT=3306

# gomachine 은 model.json 대신 이 값을 쓸 수 있다 (DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD).
DB_HOST=127.0.0.1
DB_NAME=project
DB_USER=project
DB_PASSWORD=change-me

# 백엔드(Go / Spring / Rust) 공통 JWT 서명 키 (HS256, 32자 이상)
JWT_SECRET=change-me-to-a-long-random-string-32chars
