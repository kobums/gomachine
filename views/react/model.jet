  }

{{end}}  // CRUD operations
  static async insert(item: Partial<{{.ModelName}}>) {
    const res = await post<{{.ModelName}}>('/{{.TableName | lower}}', item);
    return res.data;
  }

  static async insertBatch(items: Partial<{{.ModelName}}>[]) {
    const res = await post<{{.ModelName}}[]>('/{{.TableName | lower}}/batch', items);
    return res.data;
  }

  static async update(id: number, item: Partial<{{.ModelName}}>) {
    const res = await put<{{.ModelName}}>(`/{{.TableName | lower}}/${id}`, item);
    return res.data;
  }

  static async patch(id: number, item: Partial<{{.ModelName}}>) {
    const res = await patch<{{.ModelName}}>(`/{{.TableName | lower}}/${id}`, item);
    return res.data;
  }

  static async remove(id: number) {
    const res = await del<void>(`/{{.TableName | lower}}/${id}`);
    return res.data;
  }

  static async removeBatch(ids: number[]) {
    const res = await del<void>('/{{.TableName | lower}}/batch', { data: ids });
    return res.data;
  }

  static async find(params?: {{.ModelName}}SearchParams) {
    const res = await get<ApiResponse<{{.ModelName}}>>('/{{.TableName | lower}}', { params });
    return res.data.content || [];
  }

  static async findall(params: {{.ModelName}}SearchParams = {}) {
    const res = await get<ApiResponse<{{.ModelName}}>>('/{{.TableName | lower}}', {
      params: { ...params, page: 0, pagesize: 9999 },
    });
    return res.data.content || [];
  }

  static async findpage(params?: {{.ModelName}}SearchParams) {
    const res = await get<ApiResponse<{{.ModelName}}>>('/{{.TableName | lower}}', { params });
    return res.data
  }

  static async count(params?: {{.ModelName}}SearchParams) {
    const res = await get<{ count: number }>('/{{.TableName | lower}}/count', { params });
    return res.data.count || 0;
  }

  static async get(id: number) {
    const res = await get<ApiSingleResponse<{{.ModelName}}>>(`/{{.TableName | lower}}/${id}`);
    return res.data;
  }
{{range .SearchMethods}}
