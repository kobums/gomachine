package rest


import (
	"{{packageName}}/controllers"
	{{if passwordColumn != "" && !isView}}"{{packageName}}/global/jwt"{{end}}
	"{{packageName}}/models"
{{if restUsesConst}}
	{{constImport|raw}}
{{end}}
    {{if !isView && hasId}}"encoding/json"{{end}}
    {{if adminCheck}}"reflect"{{end}}
    {{if restNeedsStrconv}}"strconv"{{end}}
)

type {{name}}Controller struct {
	controllers.Controller
}

{{if adminCheck}}
// isAdmin 은 세션 사용자의 Level 이 adminLevel({{adminLevelNum}}) 이상인지 확인한다. 세션에 Level 필드가 없으면 false.
func (c *{{name}}Controller) isAdmin() bool {
    if c.Session == nil {
        return false
    }
    v := reflect.Indirect(reflect.ValueOf(c.Session))
    if v.Kind() != reflect.Struct {
        return false
    }
    f := v.FieldByName("Level")
    if !f.IsValid() {
        return false
    }
    switch f.Kind() {
    case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
        return f.Int() >= {{adminLevelNum}}
    case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
        return int64(f.Uint()) >= {{adminLevelNum}}
    }
    return false
}
{{end}}

{{if hasId}}func (c *{{name}}Controller) Read(id int64) {
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Result["code"] = "auth error"
        return
    }
    {{range sessions}}
    if c.Session.{{.Key|title}} == 0 {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    {{end}}
    
	conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)
	item := manager.Get(id)

    // 조회 에러와 "없는 행"을 구분한다.
    if item == nil && manager.LastError != nil {
        c.Result["code"] = "error"
        return
    }

    {{if auth == "jwt" && len(sessions) > 0}}
    // 없는 행이면 세션 비교 전에 에러로 돌려준다 (nil 역참조 방지).
    if item == nil {
        c.Result["code"] = "error"
        return
    }
    {{range sessions}}
    if item.{{.Field}} != c.Session.{{.Key|title}} {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    {{end}}
    
    c.Set("item", item)
}
{{end}}

// filters 는 목록/개수의 조건이다. 파라미터 이름은 컬럼의 API 이름(JSON key)이고, 날짜 컬럼은 start/end 범위다.
// 세션이 있으면 현재 사용자 소유 행만 고른다.
func (c *{{name}}Controller) filters() []interface{} {
    var args []interface{}
    
    {{range items}}{{if .Name != "Id" && .Name != "Passwd" && .Name != "Password" && .Type != "[]byte"}}{{if isRange(.)}}_start{{.Name|lower}} := c.Get("{{startParam(.)}}")
    _end{{.Name|lower}} := c.Get("{{endParam(.)}}")
    if _start{{.Name|lower}} != "" && _end{{.Name|lower}} != "" {        
        var v [2]string
        v[0] = _start{{.Name|lower}}
        v[1] = _end{{.Name|lower}}  
        args = append(args, models.Where{Column:"{{.Key}}", Value:v, Compare:"between"})    
    } else if  _start{{.Name|lower}} != "" {          
        args = append(args, models.Where{Column:"{{.Key}}", Value:_start{{.Name|lower}}, Compare:">="})
    } else if  _end{{.Name|lower}} != "" {          
        args = append(args, models.Where{Column:"{{.Key}}", Value:_end{{.Name|lower}}, Compare:"<="})            
    }
    {{else if .Type == "string"}}_{{.Name|lower}} := c.Get("{{jsonKey(.)}}")
    if _{{.Name|lower}} != "" {
        {{if .Name == "Name" || .Name == "Title" || .Name == "Content"}}args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"{{compareColumn(.Name, compares)}}"})
        {{else}}args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"like"}){{end}}
    }
    {{else if .Type == "int"}}_{{.Name|lower}} := c.Geti("{{jsonKey(.)}}")
    if _{{.Name|lower}} != 0 {
        args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"{{compareColumn(.Name, compares)}}"})    
    }
    {{else if .Type == "int64"}}_{{.Name|lower}} := c.Geti64("{{jsonKey(.)}}")
    if _{{.Name|lower}} != 0 {
        args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"{{compareColumn(.Name, compares)}}"})    
    }
    {{else if .Type == "float64"}}_{{.Name|lower}} := c.Getf("{{jsonKey(.)}}")
    if _{{.Name|lower}} != 0.0 {
        args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"{{compareColumn(.Name, compares)}}"})    
    }        
    {{else if enumZero(.Name)}}// 코드 0 도 실제 값이라 보낸 경우에만 조건을 붙인다.
    if _{{.Name|lower}} := c.Get("{{jsonKey(.)}}"); _{{.Name|lower}} != "" {
        if v, err := strconv.Atoi(_{{.Name|lower}}); err == nil {
            args = append(args, models.Where{Column:"{{.Key}}", Value:v, Compare:"{{compareColumn(.Name, compares)}}"})
        }
    }
    {{else}}_{{.Name|lower}} := c.Geti("{{jsonKey(.)}}")
    if _{{.Name|lower}} != 0 {
        args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"{{compareColumn(.Name, compares)}}"})    
    }
    {{end}}{{end}}{{end}}

    {{if auth == "jwt" && len(sessions) > 0}}
    {{range sessions}}
    args = append(args, models.Where{Column:"{{.Column}}", Value:c.Session.{{.Key|title}}, Compare:"="})    
    {{end}}
    {{end}}
    return args
}

// Search 는 GET /{table}/search/{field} 다. column(라우터가 넣는 이 테이블 컬럼)이 value 와 같은 행 목록을 items 로 돌려준다.
// 세션이 있으면 현재 사용자 소유 행만 고른다. 비밀번호/[]byte 컬럼은 라우터가 경로를 만들지 않는다.
func (c *{{name}}Controller) Search(column string, value interface{}) {
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Result["code"] = "auth error"
        return
    }
    {{range sessions}}
    if c.Session.{{.Key|title}} == 0 {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    {{end}}

	conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)

    args := []interface{}{models.Where{Column: column, Value: value, Compare: "="}}
    {{if auth == "jwt" && len(sessions) > 0}}
    {{range sessions}}
    args = append(args, models.Where{Column:"{{.Column}}", Value:c.Session.{{.Key|title}}, Compare:"="})
    {{end}}
    {{end}}

    items := manager.Find(args)
    if len(items) == 0 && manager.LastError != nil {
        c.Result["code"] = "error"
        return
    }
    c.Set("items", items)
}

func (c *{{name}}Controller) Index(page int, pagesize int) {
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Result["code"] = "auth error"
        return
    }
    {{range sessions}}
    if c.Session.{{.Key|title}} == 0 {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    {{end}}
    
	conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)

    args := c.filters()

    // 개수는 페이지/정렬 없이 같은 조건으로 센다.
    countArgs := args

    if page != 0 && pagesize != 0 {
        args = append(args, models.Paging(page, pagesize))
    }
    
    // orderby 는 ORDER BY 절에 들어가므로 이 테이블의 컬럼(API 이름 / 컬럼 이름) + asc/desc 만 허용하고
    // 모르는 항목은 버린다 (SQL injection 방지). 예: "createdat desc, name"
    orderby := c.Get("orderby")
    if orderby != "" {
        orderby = manager.ParseOrder(orderby)
    }
    if orderby == "" && page != 0 && pagesize != 0 {
        orderby = "{{orderKey}} desc"
    }
    if orderby != "" {
        args = append(args, models.Ordering(orderby))
    }
    
	items := manager.Find(args)
	c.Set("items", items)

    // 페이지를 요청하면 몇 번째 페이지든 전체 개수를 같이 돌려준다.
    if page != 0 && pagesize != 0 {
       total := manager.Count(countArgs)
	   c.Set("total", total)
    }
}

func (c *{{name}}Controller) Count() {
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Result["code"] = "auth error"
        return
    }
    {{range sessions}}
    if c.Session.{{.Key|title}} == 0 {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    {{end}}
    
	conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)

    args := c.filters()

    total := manager.Count(args)
	c.Set("total", total)
    // GET /{table}/count 는 Spring 과 같은 count 도 돌려준다 (total 은 예전 클라이언트용).
	c.Set("count", total)
}

{{if !isView}}func (c *{{name}}Controller) Insert(item *models.{{inputName}}) {
    {{if auth == "jwt" && name != "User"}}
    if c.Session == nil {
        c.Set("code", "error")
        return
    }
    {{range sessions}}
    if c.Session.{{.Key|title}} == 0 {
        c.Set("code", "error")
        return
    } else {
        item.{{.Field}} = c.Session.{{.Key|title}}
    }    
    {{end}}
    {{end}}

    {{if hasId}}
    // id 는 자동 증가 값을 쓴다. 클라이언트가 보낸 id 는 무시한다.
    item.Id = 0
    {{end}}
    {{range protects}}
    // 보호 컬럼은 클라이언트 값을 받지 않는다.
    {{if adminCheck}}if !c.isAdmin() {
        item.{{.}} = models.{{inputName}}{}.{{.}}
    }{{else}}item.{{.}} = models.{{inputName}}{}.{{.}}{{end}}
    {{end}}
    {{if passwordColumn != ""}}
    if item.{{passwordColumn}} != "" {
        hashed, err := jwt.GeneratePasswd(item.{{passwordColumn}})
        if err != nil {
            c.Set("code", "error")
            c.Set("error", err)
            return
        }
        item.{{passwordColumn}} = hashed
    }
    {{end}}

	conn := c.NewConnection()
    
	manager := models.New{{name}}Manager(conn)
	err := manager.Insert(item)
    if err != nil {
        c.Set("code", "error")    
        c.Set("error", err)
        return
    }

    id := manager.GetIdentity()
    c.Result["id"] = id
    {{if hasId}}item.Id = id{{end}}
}

func (c *{{name}}Controller) Insertbatch(item *[]models.{{inputName}}) {  
    if item == nil || len(*item) == 0 {
        return
    }

    rows := len(*item)
    
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Set("code", "error")
        return
    }
    {{if name != "User"}}
    {{range sessions}}
    if c.Session.{{.Key|title}} == 0 {
        c.Set("code", "error")
        return
    } else {
        for i := 0; i < rows; i++ {
            (*item)[i].{{.Field}} = c.Session.{{.Key|title}}
        }
    }    
    {{end}}
    {{end}}
    {{end}}
    
    // 모든 행을 먼저 준비(id/보호 컬럼/비밀번호 해시)한 다음 저장한다. 준비 단계에서 실패하면 아무것도 저장하지 않는다.
    // 저장은 트랜잭션이 아니다: 중간 행에서 실패하면 앞의 행은 이미 저장되어 있다.
    for i := 0; i < rows; i++ {
        {{if hasId}}
        // id 는 자동 증가 값을 쓴다. 클라이언트가 보낸 id 는 무시한다.
        (*item)[i].Id = 0
        {{end}}
        {{range protects}}
        // 보호 컬럼은 클라이언트 값을 받지 않는다.
        {{if adminCheck}}if !c.isAdmin() {
            (*item)[i].{{.}} = models.{{inputName}}{}.{{.}}
        }{{else}}(*item)[i].{{.}} = models.{{inputName}}{}.{{.}}{{end}}
        {{end}}
        {{if passwordColumn != ""}}
        if (*item)[i].{{passwordColumn}} != "" {
            hashed, err := jwt.GeneratePasswd((*item)[i].{{passwordColumn}})
            if err != nil {
                c.Set("code", "error")
                c.Set("error", err)
                return
            }
            (*item)[i].{{passwordColumn}} = hashed
        }
        {{end}}
    }

	conn := c.NewConnection()
    
	manager := models.New{{name}}Manager(conn)

    for i := 0; i < rows; i++ {
	    err := manager.Insert(&((*item)[i]))
        if err != nil {
            c.Set("code", "error")    
            c.Set("error", err)
            return
        }
    }
}
{{end}}

{{if !isView && hasId}}// Update 는 body 에 있는 필드만 기존 행에 덮어쓴다 (빠진 필드는 DB 값 유지). item 은 id 를 읽는 데만 쓴다.
// body 가 비어 있으면 item 전체로 바꾼다 (예전 동작).
func (c *{{name}}Controller) Update(item *models.{{inputName}}, body []byte) {
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Set("code", "error")
        return
    }
    {{range sessions}}
    if c.Session.{{.Key|title}} == 0 {
        c.Set("code", "error")
        return
    }
    {{end}}
    {{end}}
    {{if auth == "jwt" && name == "User"}}
    // 회원 정보는 본인만 수정/삭제할 수 있다{{if adminCheck}} (관리자 제외){{end}}.
    if {{if adminCheck}}!c.isAdmin() && {{end}}item.Id != c.Session.Id {
        c.Set("code", "auth error")
        return
    }
    {{end}}

	conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)

    // 기존 행을 읽어 소유권을 확인하고, 클라이언트가 바꾸면 안 되는 값은 기존 값을 유지한다.
    existing := manager.Get(item.Id)
    if existing == nil {
        c.Set("code", "error")
        return
    }
    {{if auth == "jwt"}}
    {{range sessions}}
    // 소유권 검사: 기존 행이 현재 세션 사용자 것인지 확인한다 (남의 행 수정/삭제 방지).
    if existing.{{.Field}} != c.Session.{{.Key|title}} {
        c.Set("code", "auth error")
        return
    }
    {{end}}
    {{end}}

    // 기존 행 위에 보낸 JSON 필드만 덮어쓴다.
    {{if inputName != name}}merged := existing.ConvertUpdate(){{else}}merged := &models.{{name}}{}
    *merged = *existing{{end}}
    if len(body) == 0 {
        body, _ = json.Marshal(item)
    }
    if err := json.Unmarshal(body, merged); err != nil {
        c.Set("code", "bad request")
        c.Set("error", err)
        return
    }
    merged.Id = item.Id
    {{if auth == "jwt"}}
    {{range sessions}}
    merged.{{.Field}} = c.Session.{{.Key|title}}
    {{end}}
    {{end}}
    {{if createdColumn != ""}}
    merged.{{createdColumn}} = existing.{{createdColumn}}
    {{end}}
    {{range protects}}
    // 보호 컬럼은 기존 값을 유지한다.
    {{if adminCheck}}if !c.isAdmin() {
        merged.{{.}} = existing.{{.}}
    }{{else}}merged.{{.}} = existing.{{.}}{{end}}
    {{end}}
    {{if passwordColumn != ""}}
    // 비밀번호를 보내지 않거나 비워 보내면 기존 해시를 유지한다.
    if merged.{{passwordColumn}} == "" || merged.{{passwordColumn}} == existing.{{passwordColumn}} {
        merged.{{passwordColumn}} = existing.{{passwordColumn}}
    } else {
        hashed, err := jwt.GeneratePasswd(merged.{{passwordColumn}})
        if err != nil {
            c.Set("code", "error")
            c.Set("error", err)
            return
        }
        merged.{{passwordColumn}} = hashed
    }
    {{end}}

    err := manager.Update(merged)
    if err != nil {
        c.Set("code", "error")    
        c.Set("error", err)
        return
    }
}

func (c *{{name}}Controller) Delete(item *models.{{name}}) {
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Set("code", "error")
        return
    }
    {{end}}

    {{if auth == "jwt" && len(sessions) > 0}}
    // 소유권 검사: 기존 행이 현재 세션 사용자 것인지 확인한다 (남의 행 수정/삭제 방지).
    if existing := models.New{{name}}Manager(c.NewConnection()).Get(item.Id); existing == nil {
        c.Set("code", "error")
        return
    } else {
        {{range sessions}}
        if existing.{{.Field}} != c.Session.{{.Key|title}} {
            c.Set("code", "auth error")
            return
        }
        {{end}}
    }
    {{end}}
    {{if auth == "jwt" && name == "User"}}
    // 회원 정보는 본인만 수정/삭제할 수 있다{{if adminCheck}} (관리자 제외){{end}}.
    if {{if adminCheck}}!c.isAdmin() && {{end}}item.Id != c.Session.Id {
        c.Set("code", "auth error")
        return
    }
    {{end}}
    
    conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)

    
	err := manager.Delete(item.Id)
    if err != nil {
        c.Set("code", "error")    
        c.Set("error", err)
    }
}

func (c *{{name}}Controller) Deletebatch(item *[]models.{{name}}) {
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Set("code", "error")
        return
    }
    {{end}}
    if item == nil {
        return
    }
    
    conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)

    {{if auth == "jwt" && (len(sessions) > 0 || name == "User")}}
    // 모든 행의 권한을 먼저 검사하고, 하나라도 실패하면 아무것도 지우지 않는다.
    for _, v := range *item {
        {{if len(sessions) > 0}}
        // 소유권 검사: 기존 행이 현재 세션 사용자 것인지 확인한다 (남의 행 수정/삭제 방지).
        if existing := manager.Get(v.Id); existing == nil {
            c.Set("code", "error")
            return
        } else {
            {{range sessions}}
            if existing.{{.Field}} != c.Session.{{.Key|title}} {
                c.Set("code", "auth error")
                return
            }
            {{end}}
        }
        {{end}}
        {{if auth == "jwt" && name == "User"}}
        // 회원 정보는 본인만 수정/삭제할 수 있다{{if adminCheck}} (관리자 제외){{end}}.
        if {{if adminCheck}}!c.isAdmin() && {{end}}v.Id != c.Session.Id {
            c.Set("code", "auth error")
            return
        }
        {{end}}
    }
    {{end}}

    // 삭제는 트랜잭션이 아니다: 중간 행에서 DB 에러가 나면 앞의 행은 이미 지워져 있다.
    for _, v := range *item {
	    err := manager.Delete(v.Id)
        if err != nil {
            c.Set("code", "error")    
            c.Set("error", err)
            return
        }
    }
}
{{end}}

{{range _, f := funcs}}
{{qt := f.Kind}}
{{if qt == "Update"}}// @Put(){{end}}{{if qt == "Delete"}}// @Delete(){{end}}
func (c *{{name}}Controller) {{f.Name}}({{range i, v := f.Wheres}}{{if i > 0}} ,{{end}}{{v.Param}} {{v.Type}}{{end}}) {{if qt == "Get"}}*models.{{name}} {{else if qt == "Find"}}[]models.{{name}} {{else if qt == "Count"}}int {{end}}{
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Result["code"] = "auth error"
        {{if qt == "Get" || qt == "Find"}}
        return nil
        {{else if qt == "Count"}}
        return 0
        {{else}}
        return
        {{end}}
    }
    {{range _, s:= sessions}}
    if c.Session.{{s.Key|title}} == 0 {
        c.Result["code"] = "auth error"
        {{if qt == "Get" || qt == "Find"}}
        return nil
        {{else if qt == "Count"}}
        return 0
        {{else}}
        return
        {{end}}
    } else {
        {{range i, v := f.Wheres}}
        {{if s.Field == v.Column}}{{if !hasPrefix(v.Type, "[]")}}
        {{v.Param}} = c.Session.{{s.Key|title}}
        {{end}}{{end}}
        {{end}}
    }
    {{end}}
    {{end}}
    {{locked := false}}{{if qt == "Update"}}{{range i, v := f.Wheres}}{{if v.Compare == "column" && isProtected(v.Column, protects)}}{{locked = true}}{{end}}{{end}}{{end}}
    {{noOwner := auth == "jwt" && name == "User" && !hasId && (qt == "Update" || qt == "Delete")}}
    {{if noOwner}}
    // id 컬럼이 없어 본인 행인지 확인할 수 없으므로 회원 정보 수정/삭제는 거부한다.
    c.Result["code"] = "auth error"
    {{else if locked && !adminCheck}}
    // 보호 컬럼은 클라이언트가 바꿀 수 없다.
    c.Result["code"] = "auth error"
    {{else}}
    {{if locked}}
    // 보호 컬럼은 관리자만 바꿀 수 있다.
    if !c.isAdmin() {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)
    {{if qt == "Get" || qt == "Find" || qt == "Count"}}
    item := manager.{{f.Name}}({{range i, v := f.Wheres}}{{if i > 0}}, {{end}}{{v.Param}}{{end}}{{if auth == "jwt"}}{{range sessions}}, models.Where{Column:"{{.Column}}", Value:c.Session.{{.Key|title}}, Compare:"="}{{end}}{{end}})
    {{if qt == "Get"}}
    c.Set("item", item)
    {{end}}
    {{if qt == "Find"}}
    c.Set("items", item)
    {{end}}
    {{if qt == "Count"}}
    c.Set("count", item)
    {{end}}
    return item
    {{else}}
    {{if auth == "jwt"}}
    {{range sessions}}
    // 소유권 검사: 조건에 맞는 행 중 다른 사용자 소유 행이 있으면 거부한다 (남의 행 수정/삭제 방지).
    if manager.Count([]interface{}{ {{range i, v := f.Wheres}}{{if qt == "Delete" || v.Compare == "where"}}models.Where{Column:"{{v.Key}}", Value:{{v.Param}}, Compare:"{{if v.Compare == "where"}}={{else}}{{v.Compare}}{{end}}"}, {{end}}{{end}}models.Where{Column:"{{.Column}}", Value:c.Session.{{.Key|title}}, Compare:"<>"}}) > 0 {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    {{if name == "User" && hasId}}
    // 회원 정보는 본인만 수정/삭제할 수 있다{{if adminCheck}} (관리자 제외){{end}}.
    if {{if adminCheck}}!c.isAdmin() && {{end}}manager.Count([]interface{}{ {{range i, v := f.Wheres}}{{if qt == "Delete" || v.Compare == "where"}}models.Where{Column:"{{v.Key}}", Value:{{v.Param}}, Compare:"{{if v.Compare == "where"}}={{else}}{{v.Compare}}{{end}}"}, {{end}}{{end}}models.Where{Column:"{{orderKey}}", Value:c.Session.Id, Compare:"<>"}}) > 0 {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    {{end}}
    err := manager.{{f.Name}}({{range i, v := f.Wheres}}{{if i > 0}}, {{end}}{{v.Param}}{{end}})
    if err != nil {
        c.Set("code", "error")
        c.Set("error", err)
    }
    {{end}}
    {{end}}
}
{{end}}
