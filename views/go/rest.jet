    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Result["code"] = "auth error"
        return
    }
    {{range sessions}}
    if c.Session.{{.Key|title}} == 0 {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    {{end}}
    
	conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)

    var args []interface{}
    
    {{range items}}{{if .Name != "Id" && .Name != "Passwd" && .Name != "Password" && .Type != "[]byte"}}{{if .OriginalType == "datetime" || .OriginalType == "date" || .OriginalType == "timestamp"}}_start{{.Name|lower}} := c.Get("start{{.Name|lower}}")
    _end{{.Name|lower}} := c.Get("end{{.Name|lower}}")
    if _start{{.Name|lower}} != "" && _end{{.Name|lower}} != "" {        
        var v [2]string
        v[0] = _start{{.Name|lower}}
        v[1] = _end{{.Name|lower}}  
        args = append(args, models.Where{Column:"{{.Key}}", Value:v, Compare:"between"})    
    } else if  _start{{.Name|lower}} != "" {          
        args = append(args, models.Where{Column:"{{.Key}}", Value:_start{{.Name|lower}}, Compare:">="})
    } else if  _end{{.Name|lower}} != "" {          
        args = append(args, models.Where{Column:"{{.Key}}", Value:_end{{.Name|lower}}, Compare:"<="})            
    }
    {{else if .Type == "string"}}_{{.Name|lower}} := c.Get("{{.Name|lower}}")
    if _{{.Name|lower}} != "" {
        {{if .Name == "Name" || .Name == "Title" || .Name == "Content"}}args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"{{compareColumn(.Name, compares)}}"})
        {{else}}args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"like"}){{end}}
        
    }
    {{else if .Type == "int"}}_{{.Name|lower}} := c.Geti("{{.Name|lower}}")
    if _{{.Name|lower}} != 0 {
        args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"{{compareColumn(.Name, compares)}}"})    
    }
    {{else if .Type == "int64"}}_{{.Name|lower}} := c.Geti64("{{.Name|lower}}")
    if _{{.Name|lower}} != 0 {
        args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"{{compareColumn(.Name, compares)}}"})    
    }
    {{else if .Type == "float64"}}_{{.Name|lower}} := c.Getf("{{.Name|lower}}")
    if _{{.Name|lower}} != 0.0 {
        args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"{{compareColumn(.Name, compares)}}"})    
    }        
    {{else}}_{{.Name|lower}} := c.Geti("{{.Name|lower}}")
    if _{{.Name|lower}} != 0 {
        args = append(args, models.Where{Column:"{{.Key}}", Value:_{{.Name|lower}}, Compare:"{{compareColumn(.Name, compares)}}"})    
    }
    {{end}}{{end}}{{end}}
    
    {{if auth == "jwt" && len(sessions) > 0}}
    {{range sessions}}
    args = append(args, models.Where{Column:"{{.Column}}", Value:c.Session.{{.Key|title}}, Compare:"="})    
    {{end}}
    {{end}}
    
    total := manager.Count(args)
	c.Set("total", total)
}

{{if !isView}}func (c *{{name}}Controller) Insert(item *models.{{inputName}}) {
    {{if auth == "jwt" && name != "User"}}
    if c.Session == nil {
        c.Set("code", "error")
        return
    }
    {{range sessions}}
    if c.Session.{{.Key|title}} == 0 {
        c.Set("code", "error")
        return
    } else {
        item.{{.Field}} = c.Session.{{.Key|title}}
    }    
    {{end}}
    {{end}}

    {{if hasId}}
    // id 는 자동 증가 값을 쓴다. 클라이언트가 보낸 id 는 무시한다.
    item.Id = 0
    {{end}}
    {{range protects}}
    // 보호 컬럼은 클라이언트 값을 받지 않는다.
    {{if adminCheck}}if !c.isAdmin() {
        item.{{.}} = models.{{inputName}}{}.{{.}}
    }{{else}}item.{{.}} = models.{{inputName}}{}.{{.}}{{end}}
    {{end}}
    {{if passwordColumn != ""}}
    if item.{{passwordColumn}} != "" {
        hashed, err := jwt.GeneratePasswd(item.{{passwordColumn}})
        if err != nil {
            c.Set("code", "error")
            c.Set("error", err)
            return
        }
        item.{{passwordColumn}} = hashed
    }
    {{end}}

	conn := c.NewConnection()
    
	manager := models.New{{name}}Manager(conn)
	err := manager.Insert(item)
    if err != nil {
        c.Set("code", "error")    
        c.Set("error", err)
        return
    }

    id := manager.GetIdentity()
    c.Result["id"] = id
    {{if hasId}}item.Id = id{{end}}
}

func (c *{{name}}Controller) Insertbatch(item *[]models.{{inputName}}) {  
    if item == nil || len(*item) == 0 {
        return
    }

    rows := len(*item)
    
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Set("code", "error")
        return
    }
    {{if name != "User"}}
    {{range sessions}}
    if c.Session.{{.Key|title}} == 0 {
        c.Set("code", "error")
        return
    } else {
        for i := 0; i < rows; i++ {
            (*item)[i].{{.Field}} = c.Session.{{.Key|title}}
        }
    }    
    {{end}}
    {{end}}
    {{end}}
    
	conn := c.NewConnection()
    
	manager := models.New{{name}}Manager(conn)

    for i := 0; i < rows; i++ {
        {{if hasId}}
        // id 는 자동 증가 값을 쓴다. 클라이언트가 보낸 id 는 무시한다.
        (*item)[i].Id = 0
        {{end}}
        {{range protects}}
        // 보호 컬럼은 클라이언트 값을 받지 않는다.
        {{if adminCheck}}if !c.isAdmin() {
            (*item)[i].{{.}} = models.{{inputName}}{}.{{.}}
        }{{else}}(*item)[i].{{.}} = models.{{inputName}}{}.{{.}}{{end}}
        {{end}}
        {{if passwordColumn != ""}}
        if (*item)[i].{{passwordColumn}} != "" {
            hashed, err := jwt.GeneratePasswd((*item)[i].{{passwordColumn}})
            if err != nil {
                c.Set("code", "error")
                c.Set("error", err)
                return
            }
            (*item)[i].{{passwordColumn}} = hashed
        }
        {{end}}
	    err := manager.Insert(&((*item)[i]))
        if err != nil {
            c.Set("code", "error")    
            c.Set("error", err)
            return
        }
    }
}
{{end}}

{{if !isView && hasId}}func (c *{{name}}Controller) Update(item *models.{{inputName}}) {
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Set("code", "error")
        return
    }
    {{range sessions}}
    if c.Session.{{.Key|title}} == 0 {
        c.Set("code", "error")
        return
    } else {
        item.{{.Field}} = c.Session.{{.Key|title}}
    }    
    {{end}}
    {{end}}
    {{if auth == "jwt" && name == "User"}}
    // 회원 정보는 본인만 수정/삭제할 수 있다{{if adminCheck}} (관리자 제외){{end}}.
    if {{if adminCheck}}!c.isAdmin() && {{end}}item.Id != c.Session.Id {
        c.Set("code", "auth error")
        return
    }
    {{end}}

	conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)

    // 기존 행을 읽어 소유권을 확인하고, 클라이언트가 바꾸면 안 되는 값은 기존 값을 유지한다.
    existing := manager.Get(item.Id)
    if existing == nil {
        c.Set("code", "error")
        return
    }
    {{if auth == "jwt"}}
    {{range sessions}}
    // 소유권 검사: 기존 행이 현재 세션 사용자 것인지 확인한다 (남의 행 수정/삭제 방지).
    if existing.{{.Field}} != c.Session.{{.Key|title}} {
        c.Set("code", "auth error")
        return
    }
    {{end}}
    {{end}}
    {{if createdColumn != ""}}
    item.{{createdColumn}} = existing.{{createdColumn}}
    {{end}}
    {{range protects}}
    // 보호 컬럼은 기존 값을 유지한다.
    {{if adminCheck}}if !c.isAdmin() {
        item.{{.}} = existing.{{.}}
    }{{else}}item.{{.}} = existing.{{.}}{{end}}
    {{end}}
    {{if passwordColumn != ""}}
    // 비밀번호를 보내지 않으면 기존 해시를 유지한다.
    if item.{{passwordColumn}} == "" {
        item.{{passwordColumn}} = existing.{{passwordColumn}}
    } else {
        hashed, err := jwt.GeneratePasswd(item.{{passwordColumn}})
        if err != nil {
            c.Set("code", "error")
            c.Set("error", err)
            return
        }
        item.{{passwordColumn}} = hashed
    }
    {{end}}

    err := manager.Update(item)
    if err != nil {
        c.Set("code", "error")    
        c.Set("error", err)
        return
    }
}

func (c *{{name}}Controller) Delete(item *models.{{name}}) {
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Set("code", "error")
        return
    }
    {{end}}

    {{if auth == "jwt" && len(sessions) > 0}}
    // 소유권 검사: 기존 행이 현재 세션 사용자 것인지 확인한다 (남의 행 수정/삭제 방지).
    if existing := models.New{{name}}Manager(c.NewConnection()).Get(item.Id); existing == nil {
        c.Set("code", "error")
        return
    } else {
        {{range sessions}}
        if existing.{{.Field}} != c.Session.{{.Key|title}} {
            c.Set("code", "auth error")
            return
        }
        {{end}}
    }
    {{end}}
    {{if auth == "jwt" && name == "User"}}
    // 회원 정보는 본인만 수정/삭제할 수 있다{{if adminCheck}} (관리자 제외){{end}}.
    if {{if adminCheck}}!c.isAdmin() && {{end}}item.Id != c.Session.Id {
        c.Set("code", "auth error")
        return
    }
    {{end}}
    
    conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)

    
	err := manager.Delete(item.Id)
    if err != nil {
        c.Set("code", "error")    
        c.Set("error", err)
    }
}

func (c *{{name}}Controller) Deletebatch(item *[]models.{{name}}) {
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Set("code", "error")
        return
    }
    {{end}}
    if item == nil {
        return
    }
    
    conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)

    for _, v := range *item {
        {{if auth == "jwt" && len(sessions) > 0}}
        // 소유권 검사: 기존 행이 현재 세션 사용자 것인지 확인한다 (남의 행 수정/삭제 방지).
        if existing := manager.Get(v.Id); existing == nil {
            c.Set("code", "error")
            return
        } else {
            {{range sessions}}
            if existing.{{.Field}} != c.Session.{{.Key|title}} {
                c.Set("code", "auth error")
                return
            }
            {{end}}
        }
        {{end}}
        {{if auth == "jwt" && name == "User"}}
        // 회원 정보는 본인만 수정/삭제할 수 있다{{if adminCheck}} (관리자 제외){{end}}.
        if {{if adminCheck}}!c.isAdmin() && {{end}}v.Id != c.Session.Id {
            c.Set("code", "auth error")
            return
        }
        {{end}}

	    err := manager.Delete(v.Id)
        if err != nil {
            c.Set("code", "error")    
            c.Set("error", err)
            return
        }
    }
}
{{end}}

{{range _, f := funcs}}
{{qt := f.Kind}}
{{if qt == "Update"}}// @Put(){{end}}{{if qt == "Delete"}}// @Delete(){{end}}
func (c *{{name}}Controller) {{f.Name}}({{range i, v := f.Wheres}}{{if i > 0}} ,{{end}}{{v.Param}} {{v.Type}}{{end}}) {{if qt == "Get"}}*models.{{name}} {{else if qt == "Find"}}[]models.{{name}} {{else if qt == "Count"}}int {{end}}{
    {{if auth == "jwt"}}
    if c.Session == nil {
        c.Result["code"] = "auth error"
        {{if qt == "Get" || qt == "Find"}}
        return nil
        {{else if qt == "Count"}}
        return 0
        {{else}}
        return
        {{end}}
    }
    {{range _, s:= sessions}}
    if c.Session.{{s.Key|title}} == 0 {
        c.Result["code"] = "auth error"
        {{if qt == "Get" || qt == "Find"}}
        return nil
        {{else if qt == "Count"}}
        return 0
        {{else}}
        return
        {{end}}
    } else {
        {{range i, v := f.Wheres}}
        {{if s.Field == v.Column}}{{if !hasPrefix(v.Type, "[]")}}
        {{v.Param}} = c.Session.{{s.Key|title}}
        {{end}}{{end}}
        {{end}}
    }
    {{end}}
    {{end}}
    {{locked := false}}{{if qt == "Update"}}{{range i, v := f.Wheres}}{{if v.Compare == "column" && isProtected(v.Column, protects)}}{{locked = true}}{{end}}{{end}}{{end}}
    {{noOwner := auth == "jwt" && name == "User" && !hasId && (qt == "Update" || qt == "Delete")}}
    {{if noOwner}}
    // id 컬럼이 없어 본인 행인지 확인할 수 없으므로 회원 정보 수정/삭제는 거부한다.
    c.Result["code"] = "auth error"
    {{else if locked && !adminCheck}}
    // 보호 컬럼은 클라이언트가 바꿀 수 없다.
    c.Result["code"] = "auth error"
    {{else}}
    {{if locked}}
    // 보호 컬럼은 관리자만 바꿀 수 있다.
    if !c.isAdmin() {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    conn := c.NewConnection()

	manager := models.New{{name}}Manager(conn)
    {{if qt == "Get" || qt == "Find" || qt == "Count"}}
    item := manager.{{f.Name}}({{range i, v := f.Wheres}}{{if i > 0}}, {{end}}{{v.Param}}{{end}}{{if auth == "jwt"}}{{range sessions}}, models.Where{Column:"{{.Column}}", Value:c.Session.{{.Key|title}}, Compare:"="}{{end}}{{end}})
    {{if qt == "Get"}}
    c.Set("item", item)
    {{end}}
    {{if qt == "Find"}}
    c.Set("items", item)
    {{end}}
    {{if qt == "Count"}}
    c.Set("count", item)
    {{end}}
    return item
    {{else}}
    {{if auth == "jwt"}}
    {{range sessions}}
    // 소유권 검사: 조건에 맞는 행 중 다른 사용자 소유 행이 있으면 거부한다 (남의 행 수정/삭제 방지).
    if manager.Count([]interface{}{ {{range i, v := f.Wheres}}{{if qt == "Delete" || v.Compare == "where"}}models.Where{Column:"{{v.Key}}", Value:{{v.Param}}, Compare:"{{if v.Compare == "where"}}={{else}}{{v.Compare}}{{end}}"}, {{end}}{{end}}models.Where{Column:"{{.Column}}", Value:c.Session.{{.Key|title}}, Compare:"<>"}}) > 0 {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    {{if name == "User" && hasId}}
    // 회원 정보는 본인만 수정/삭제할 수 있다{{if adminCheck}} (관리자 제외){{end}}.
    if {{if adminCheck}}!c.isAdmin() && {{end}}manager.Count([]interface{}{ {{range i, v := f.Wheres}}{{if qt == "Delete" || v.Compare == "where"}}models.Where{Column:"{{v.Key}}", Value:{{v.Param}}, Compare:"{{if v.Compare == "where"}}={{else}}{{v.Compare}}{{end}}"}, {{end}}{{end}}models.Where{Column:"{{orderKey}}", Value:c.Session.Id, Compare:"<>"}}) > 0 {
        c.Result["code"] = "auth error"
        return
    }
    {{end}}
    {{end}}
    err := manager.{{f.Name}}({{range i, v := f.Wheres}}{{if i > 0}}, {{end}}{{v.Param}}{{end}})
    if err != nil {
        c.Set("code", "error")
        c.Set("error", err)
    }
    {{end}}
    {{end}}
}
{{end}}
