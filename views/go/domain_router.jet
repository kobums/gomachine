// Setup{{modelName}}Routes sets up routes for {{domainName}} domain
func Setup{{modelName}}Routes(group fiber.Router) {
{{range routes}}
	group.{{.Method}}("{{.URL}}", func(c *fiber.Ctx) error {
{{.ParamCode|raw}}
		var controller {{.ControllerName}}
		controller.Init(c)
		controller.{{.FuncName}}({{.ParamStr|raw}})
		controller.Close()
		return c.JSON(controller.Result)
	})
{{end}}
}
