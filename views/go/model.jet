package models

import (
    "{{packageName}}/global/config"
    {{if modelUsesConst}}{{constImport|raw}}{{end}}
    "database/sql"
    {{if !isView}}"errors"{{end}}
    "fmt"
    "strings"
    {{if needsTime}}"time"{{end}}
    {{if hasNullable}}"reflect"{{end}}

    log "{{packageName}}/global/log"
    _ "github.com/go-sql-driver/mysql"
    _ "github.com/lib/pq"

)

type {{name}} struct {
    {{range items}}        
    {{.Name}}                {{if .Name == "Id"}}int64{{else}}{{.Type}}{{end}} `json:{{if .Name == passwordColumn}}"-"{{else}}"{{jsonKey(.)}}"{{end}}` {{end}}
    
    Extra                    map[string]interface{} `json:"extra"`
}
{{if inputName != name}}// {{name}}Update 는 REST 입력용 구조체다. 비밀번호를 입력받을 수 있고, 출력용 {{name}} 은 비밀번호를 json 에서 숨긴다.
type {{name}}Update struct {
    {{range items}}        
    {{.Name}}                {{if .Name == "Id"}}int64{{else}}{{.Type}}{{end}} `json:"{{jsonKey(.)}}"` {{end}}
    
    Extra                    map[string]interface{} `json:"extra"`
}
{{end}}
type {{name}}Manager struct {
    Conn    *Connection
    Result  *sql.Result
    Index   string
    Isolation   bool
    SelectQuery  string
    JoinQuery string
    CountQuery   string
    GroupQuery string
    SelectLog bool
    Log bool
    // LastError 는 마지막 조회(Get/Find/Count)의 DB 에러다. nil 결과가 "없음"인지 "에러"인지 구분할 때 쓴다.
    LastError error
}
{{if inputName != name}}func (c *{{name}}) ConvertUpdate() *{{name}}Update {    
    item := &{{name}}Update{}
    {{range items}}        
    item.{{.Name}} = c.{{.Name}}{{end}}

    return item
}
{{end}}
func (c *{{name}}) AddExtra(key string, value interface{}) {    
	c.Extra[key] = value     
}

func New{{name}}Manager(conn *Connection) *{{name}}Manager {
    var item {{name}}Manager


    if conn == nil {
        item.Conn = NewConnection()
        item.Isolation = false
    } else {
        item.Conn = conn 
        item.Isolation = conn.Isolation
    }

    item.Index = ""
    item.SelectLog = config.Log.Database
    item.Log = config.Log.Database

    return &item
}

func (p *{{name}}Manager) Close() {
    if p.Conn != nil {
        p.Conn.Close()
    }
}

func (p *{{name}}Manager) SetIndex(index string) {
    p.Index = index
}

func (p *{{name}}Manager) SetCountQuery(query string) {
    p.CountQuery = query
}

func (p *{{name}}Manager) SetSelectQuery(query string) {
    p.SelectQuery = query
}

func (p *{{name}}Manager) Exec(query string, params ...interface{}) (sql.Result, error) {
    if p.Log {
       if len(params) > 0 {
	       log.Debug().Str("query", query).Any("param", params).Msg("SQL")
       } else {
	       log.Debug().Str("query", query).Msg("SQL")
       }
    }

    return p.Conn.Exec(query, params...)
}

func (p *{{name}}Manager) Query(query string, params ...interface{}) (*sql.Rows, error) {
    if p.Isolation {
        query += " for update"
    }

    if p.SelectLog {
       if len(params) > 0 {
	       log.Debug().Str("query", query).Any("param", params).Msg("SQL")
       } else {
	       log.Debug().Str("query", query).Msg("SQL")
       }
    }

    return p.Conn.Query(query, params...)
}

// orderColumns{{name}} 은 정렬에 쓸 수 있는 이름(API 이름, 접두사 뺀 이름, 전체 이름. 소문자)과 SQL 컬럼이다.
var orderColumns{{name}} = map[string]string{
{{range orderColumns}}    "{{.Key}}": "{{.Column}}",
{{end}}}

// OrderColumn 은 정렬 이름에 해당하는 SQL 컬럼이다. 모르는 이름이면 "".
func (p *{{name}}Manager) OrderColumn(name string) string {
    return orderColumns{{name}}[strings.ToLower(strings.TrimSpace(name))]
}

// FixOrder 는 코드에서 넘긴 정렬 문자열의 각 항목 중 알려진 컬럼 이름만 SQL 컬럼으로 바꾼다.
// 이미 SQL 컬럼인 이름, 조인 테이블 컬럼, rand() 같은 식은 그대로 둔다.
func (p *{{name}}Manager) FixOrder(orderby string) string {
    parts := strings.Split(orderby, ",")
    for i, part := range parts {
        fields := strings.Fields(part)
        if len(fields) == 0 {
            continue
        }
        if col := p.OrderColumn(fields[0]); col != "" {
            fields[0] = col
        }
        parts[i] = strings.Join(fields, " ")
    }
    return strings.Join(parts, ", ")
}

// ParseOrder 는 클라이언트가 보낸 정렬 문자열("createdat desc, name")을 검증해 SQL 정렬 절로 바꾼다.
// 각 항목은 알려진 컬럼 + asc/desc 만 허용하고 나머지 항목은 버린다 (SQL injection 방지). 남은 항목이 없으면 "".
func (p *{{name}}Manager) ParseOrder(orderby string) string {
    ret := make([]string, 0)
    for _, part := range strings.Split(orderby, ",") {
        fields := strings.Fields(part)
        if len(fields) == 0 || len(fields) > 2 {
            continue
        }
        col := p.OrderColumn(fields[0])
        if col == "" {
            continue
        }
        if len(fields) == 2 {
            dir := strings.ToLower(fields[1])
            if dir != "asc" && dir != "desc" {
                continue
            }
            col += " " + dir
        }
        ret = append(ret, col)
    }
    return strings.Join(ret, ", ")
}

func (p *{{name}}Manager) GetQuery() string {
    if p.SelectQuery != "" {
        return p.SelectQuery    
    }

    var ret strings.Builder

    ret.WriteString("select {{range i, v := items}}{{if i > 0}}, {{end}}{{v.Column}}{{end}}{{range i2, v2 := joins}}{{range columns(v2.Name)}}, {{.Column}}{{end}}{{end}} from {{tableName}}{{range joins}}, {{.Name}}_tb{{end}}")

    if p.Index != "" {
        ret.WriteString(" use index(")
        ret.WriteString(p.Index)
        ret.WriteString(")")
    }

    if p.JoinQuery != "" {
        ret.WriteString(", ")
        ret.WriteString(p.JoinQuery)
    }

    ret.WriteString(" where 1=1 ")
    {{range joins}}
    ret.WriteString("and {{prefix}}_{{.Column}} = {{.Prefix}}_id ")
    {{end}}

    return ret.String()
}

func (p *{{name}}Manager) GetQuerySelect() string {
    if p.CountQuery != "" {
        return p.CountQuery    
    }

    var ret strings.Builder
    
    // 조인 조건을 붙이므로 GetQuery 와 같이 조인 테이블도 from 에 넣는다.
    ret.WriteString("select count(*) from {{tableName}}{{range joins}}, {{.Name}}_tb{{end}}")

    if p.Index != "" {
        ret.WriteString(" use index(")
        ret.WriteString(p.Index)
        ret.WriteString(")")
    }

    if p.JoinQuery != "" {
        ret.WriteString(", ")
        ret.WriteString(p.JoinQuery)
    }

    ret.WriteString(" where 1=1 ")
    {{range joins}}
    ret.WriteString("and {{prefix}}_{{.Column}} = {{.Prefix}}_id ")
    {{end}}

    return ret.String()
}

func (p *{{name}}Manager) GetQueryGroup(name string) string {
    if p.SelectQuery != "" {
        return p.SelectQuery    
    }

    var ret strings.Builder
    ret.WriteString("select {{prefix}}_")
    ret.WriteString(name)
    ret.WriteString(", count(*) from {{tableName}}{{range joins}}, {{.Name}}_tb{{end}} ")

    if p.Index != "" {
        ret.WriteString(" use index(")
        ret.WriteString(p.Index)
        ret.WriteString(")")
    }

    ret.WriteString(" where 1=1 ")
    {{range joins}}
    ret.WriteString("and {{prefix}}_{{.Column}} = {{.Prefix}}_id ")
    {{end}}

    return ret.String()
}

{{if !isView}}func (p *{{name}}Manager) Truncate() error {
    if !p.Conn.IsConnect() {
        return errors.New("Connection Error")
    }
    
    query := "truncate {{tableName}} "
    _, err := p.Exec(query)

    if err != nil {
       if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
       }
    }

    return err
}

func (p *{{name}}Manager) Insert(item *{{inputName}}) error {
    if !p.Conn.IsConnect() {
        return errors.New("Connection Error")
    }

    {{if createdDefault}}
    if item.Createddate == "" {
        t := time.Now().UTC().Add(time.Hour * 9)
        //t := time.Now()
        item.Createddate = fmt.Sprintf("%04d-%02d-%02d %02d:%02d:%02d", t.Year(), t.Month(), t.Day(), t.Hour(), t.Minute(), t.Second())
    }
    {{end}}

    // NOT NULL 날짜 컬럼이 비어 있으면 기본값(현재 시각 / 고정 값 / 자리표시 값)을 넣는다. null 허용 컬럼은 NULL 로 저장한다.
    {{range items}}{{if dateFill(.Name) != ""}}
    if item.{{.Name}} == "" {
       item.{{.Name}} = {{dateFill(.Name)|raw}}
    }
	{{end}}{{end}}

    query := ""
    var res sql.Result
    var err error
    {{if hasId}}if item.Id > 0 {
        query = "insert into {{tableName}} ({{range i, v := items}}{{if i > 0}}, {{end}}{{v.Column}}{{end}}) values ({{range i, v := items}}{{if i > 0}}, {{end}}?{{end}})"
        res, err = p.Exec(query{{range items}}, {{writeParam(.Name, "item." + .Name)|raw}}{{end}})
    } else {
        query = "insert into {{tableName}} ({{range i, v := nonIdItems}}{{if i > 0}}, {{end}}{{v.Column}}{{end}}) values ({{range i, v := nonIdItems}}{{if i > 0}}, {{end}}?{{end}})"
        res, err = p.Exec(query{{range nonIdItems}}, {{writeParam(.Name, "item." + .Name)|raw}}{{end}})
    }{{else}}
    query = "insert into {{tableName}} ({{range i, v := items}}{{if i > 0}}, {{end}}{{v.Column}}{{end}}) values ({{range i, v := items}}{{if i > 0}}, {{end}}?{{end}})"
    res, err = p.Exec(query{{range items}}, {{writeParam(.Name, "item." + .Name)|raw}}{{end}}){{end}}
    
    if err == nil {
        p.Result = &res
        
    } else {
        if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
        }
        p.Result = nil
    }

    return err
}

