func (p *{{name}}Manager) MakeQuery(initQuery string , postQuery string, initParams []interface{}, args []interface{}) (string, []interface{}) {
    var params []interface{}
    if initParams != nil {
        params = append(params, initParams...)
    }

    // Postgres 자리표시 번호($n)는 initParams 다음부터 시작한다.
    pos := len(params) + 1

    var query strings.Builder
	query.WriteString(initQuery)

    for _, arg := range args {
        switch v := arg.(type) {        
        case Where:
            clause, whereParams := WhereClause("{{prefix}}_", v, &pos)
            query.WriteString(clause)
            params = append(params, whereParams...)
        case Custom:
             item := v

            query.WriteString(" and ")
            query.WriteString(item.Query)
            params = append(params, item.Params...)
        }        
    }

	query.WriteString(postQuery)

    return query.String(), params
}

{{if !isView}}func (p *{{name}}Manager) DeleteWhere(args []interface{}) error {
    if !p.Conn.IsConnect() {
        return errors.New("Connection Error")
    }

    query, params := p.MakeQuery("delete from {{tableName}} where 1=1", "", nil, args)
    _, err := p.Exec(query, params...)

    if err != nil {
       if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
       }
    }

    return err
}

{{if hasId}}func (p *{{name}}Manager) Update(item *{{inputName}}) error {
    if !p.Conn.IsConnect() {
        return errors.New("Connection Error")
    }
    
    // NOT NULL 날짜 컬럼이 비어 있으면 기본값(현재 시각 / 고정 값 / 자리표시 값)을 넣는다. null 허용 컬럼은 NULL 로 저장한다.
    {{range items}}{{if dateFill(.Name) != ""}}
    if item.{{.Name}} == "" {
       item.{{.Name}} = {{dateFill(.Name)|raw}}
    }
	{{end}}{{end}}

	query := "update {{tableName}} set {{range i, v := nonIdItems}}{{if i > 0}}, {{end}}{{v.Column}} = ?{{end}} where {{prefix}}_id = ?"
	_, err := p.Exec(query{{range nonIdItems}}, {{writeParam(.Name, "item." + .Name)|raw}}{{end}}, item.Id)

    if err != nil {
        if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
        }
    }
    
        
    return err
}
{{end}}

func (p *{{name}}Manager) UpdateWhere(columns []{{constPkg}}.Params, args []interface{}) error {
    if !p.Conn.IsConnect() {
        return errors.New("Connection Error")
    }

    var initQuery strings.Builder
    var initParams []interface{}

    initQuery.WriteString("update {{tableName}} set ")
    for i, v := range columns {
        if i > 0 {
            initQuery.WriteString(", ")
        }

        placeholder := "?"
        if config.Database.Type == config.Postgresql {
            placeholder = fmt.Sprintf("$%d", len(initParams)+1)
        }

        {{range items}}if v.Column == {{constPkg}}.Column{{.Name}} {
        initQuery.WriteString("{{.Column}} = " + placeholder)
        initParams = append(initParams, {{writeParam(.Name, "v.Value")|raw}})
        } else {{end}}{
        
        }
    }

    initQuery.WriteString(" where 1=1 ")

    query, params := p.MakeQuery(initQuery.String(), "", initParams, args)
    _, err := p.Exec(query, params...)

    if err != nil {
       if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
       }
    }

    
    return err
}

{{if hasNullable}}
// nullIfZero 는 null 허용 날짜/시간 컬럼의 빈 값을 NULL 로 저장하게 한다. 읽을 때 NULL 은 빈 값이 되므로 서로 맞는다.
func (p *{{name}}Manager) nullIfZero(v interface{}) interface{} {
    if v == nil || reflect.ValueOf(v).IsZero() {
        return nil
    }
    return v
}
{{end}}
{{end}}

func (p *{{name}}Manager) GetIdentity() int64 {
    if !p.Conn.IsConnect() {
        return 0
    }

    id, err := (*p.Result).LastInsertId()

    if err != nil {
        if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
        }
        return 0
    } else {
        return id
    }
}

func (p *{{name}}) InitExtra() {
    p.Extra = map[string]interface{}{
{{range consts}}{{if .Field != ""}}            "{{.Key}}":     {{constPkg}}.Get{{.Name}}(p.{{.Field}}),
{{end}}{{end}}
    }
}

func (p *{{name}}Manager) ReadRow(rows *sql.Rows) *{{name}} {
    var item {{name}}
    var err error

    {{range joins}}var _{{joinVar(.)}} {{camel(.Name)}}
    {{end}}

    if rows.Next() {
        // null 허용 컬럼은 sql.Null* 로 읽어 0 값으로 바꾼다.
        {{scanDecls|raw}}
        err = rows.Scan({{scanTargets|raw}})
        {{scanAssigns|raw}}
        {{range i, v := items}}{{if v.OriginalType == "date" || v.OriginalType == "datetime" || v.OriginalType == "timestamp"}}
        if item.{{v.Name}} == "0000-00-00 00:00:00" || item.{{v.Name}} == "1000-01-01 00:00:00" || item.{{v.Name}} == "9999-01-01 00:00:00" || item.{{v.Name}} == "0000-00-00" || item.{{v.Name}} == "1000-01-01" {
            item.{{v.Name}} = ""
        }

        if config.Database.Type == config.Postgresql {
            item.{{v.Name}} = strings.ReplaceAll(strings.ReplaceAll(item.{{v.Name}}, "T", " "), "Z", "")
        }
		{{end}}{{end}}

    } else {
        if err := rows.Err(); err != nil {
            p.LastError = err
            log.Error().Str("error", err.Error()).Msg("SQL")
        }
        return nil
    }

    if err != nil {
        p.LastError = err
        log.Error().Str("error", err.Error()).Msg("SQL")
        return nil
    } else {

        item.InitExtra()
        {{range joins}}_{{joinVar(.)}}.InitExtra()
        item.AddExtra("{{joinVar(.)}}",  _{{joinVar(.)}})
{{end}}
        return &item
    }
}

func (p *{{name}}Manager) ReadRows(rows *sql.Rows) []{{name}} {
    var items []{{name}}

    for rows.Next() {
        var item {{name}}
        {{range joins}}var _{{joinVar(.)}} {{camel(.Name)}}
        {{end}}

        // null 허용 컬럼은 sql.Null* 로 읽어 0 값으로 바꾼다.
        {{scanDecls|raw}}
        err := rows.Scan({{scanTargets|raw}})
        if err != nil {
           // 한 행을 읽지 못해도 나머지 행은 계속 읽는다 (예전에는 여기서 멈춰 뒤의 행이 조용히 빠졌다).
           p.LastError = err
           log.Error().Str("error", err.Error()).Msg("SQL")
           continue
        }
        {{scanAssigns|raw}}

        {{range i, v := items}}{{if v.OriginalType == "date" || v.OriginalType == "datetime" || v.OriginalType == "timestamp"}}
        if item.{{v.Name}} == "0000-00-00 00:00:00" || item.{{v.Name}} == "1000-01-01 00:00:00" || item.{{v.Name}} == "9999-01-01 00:00:00" || item.{{v.Name}} == "0000-00-00" || item.{{v.Name}} == "1000-01-01" {
            item.{{v.Name}} = ""
        }

        if config.Database.Type == config.Postgresql {
            item.{{v.Name}} = strings.ReplaceAll(strings.ReplaceAll(item.{{v.Name}}, "T", " "), "Z", "")
        }
		{{end}}{{end}}

        item.InitExtra()
        {{range joins}}_{{joinVar(.)}}.InitExtra()
        item.AddExtra("{{joinVar(.)}}",  _{{joinVar(.)}})
{{end}}
        items = append(items, item)
    }

    if err := rows.Err(); err != nil {
        p.LastError = err
        log.Error().Str("error", err.Error()).Msg("SQL")
    }

     return items
}

{{if hasId}}func (p *{{name}}Manager) Get(id int64) *{{name}} {
    if !p.Conn.IsConnect() {
        return nil
    }

    p.LastError = nil

    var query strings.Builder
    query.WriteString(p.GetQuery())
    query.WriteString(" and {{prefix}}_id = ?")

    {{range joins}}
    query.WriteString(" and {{prefix}}_{{.Column}} = {{.Prefix}}_id")
    {{end}}
    
    rows, err := p.Query(query.String(), id)

    if err != nil {
       p.LastError = err
       if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
       }
       return nil
    }

    defer rows.Close()

    return p.ReadRow(rows)
}
{{end}}

func (p *{{name}}Manager) GetWhere(args []interface{}) *{{name}} {
    items := p.Find(args)
    if len(items) == 0 {
        return nil
    }

    return &items[0]
}

func (p *{{name}}Manager) Count(args []interface{}) int {
    if !p.Conn.IsConnect() {
        return 0
    }

    p.LastError = nil
    query, params := p.MakeQuery(p.GetQuerySelect(), p.GroupQuery, nil, args)
    rows, err := p.Query(query, params...)

    if err != nil {
       p.LastError = err
       if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
       }
       return 0
    }

    defer rows.Close()

    if !rows.Next() {
        p.LastError = rows.Err()
        return 0
    }

    cnt := 0
    err = rows.Scan(&cnt)

    if err != nil {
        p.LastError = err
        log.Error().Str("error", err.Error()).Msg("SQL")
        return 0
    } else {
        return cnt
    }
}

func (p *{{name}}Manager) FindAll() []{{name}} {
    return p.Find(nil)
}

func (p *{{name}}Manager) Find(args []interface{}) []{{name}} {
    if !p.Conn.IsConnect() {
        var items []{{name}}
        return items
    }

    p.LastError = nil

    var params []interface{}
    baseQuery := p.GetQuery()

    var query strings.Builder

    page := 0
    pagesize := 0
    orderby := ""

    pos := 1
    
    for _, arg := range args {
        switch v := arg.(type) {
        case PagingType:
            item := v
            page = item.Page
            pagesize = item.Pagesize            
        case OrderingType:
            item := v
            orderby = item.Order
        case LimitType:
            item := v
            page = 1
            pagesize = item.Limit
        case OptionType:
            item := v
            if item.Limit > 0 {
                page = 1
                pagesize = item.Limit
            } else {
                page = item.Page
                pagesize = item.Pagesize                
            }
            orderby = item.Order
        case Where:
            clause, whereParams := WhereClause("{{prefix}}_", v, &pos)
            query.WriteString(clause)
            params = append(params, whereParams...)
        case Custom:
             item := v

            query.WriteString(" and ")
            query.WriteString(item.Query)
            params = append(params, item.Params...)
        case Base:
             item := v

             baseQuery = item.Query
        }
    }

    query.WriteString(p.GroupQuery)
    
    startpage := (page - 1) * pagesize
    
    if page > 0 && pagesize > 0 {
        if orderby == "" {
            orderby = "{{prefix}}_{{orderKey}} desc"
        } else {
            // 알려진 컬럼 이름(created_at, createdat ...)만 SQL 컬럼으로 바꾼다.
            orderby = p.FixOrder(orderby)
        }
        query.WriteString(" order by ")
        query.WriteString(orderby)
        if config.Database.Type == config.Postgresql {
            query.WriteString(fmt.Sprintf(" limit $%v offset $%v", pos, pos + 1))
            params = append(params, pagesize)
            params = append(params, startpage)
        } else if config.Database.Type == config.Mysql {
            query.WriteString(" limit ? offset ?")
            params = append(params, pagesize)
            params = append(params, startpage)
        } else if config.Database.Type == config.Sqlserver {
            query.WriteString(" OFFSET ? ROWS FETCH NEXT ? ROWS ONLY")
            params = append(params, startpage)
            params = append(params, pagesize)
        }
    } else {
        if orderby == "" {
            orderby = "{{prefix}}_{{orderKey}}"
        } else {
            orderby = p.FixOrder(orderby)
        }
        query.WriteString(" order by ")
        query.WriteString(orderby)
    }

    rows, err := p.Query(baseQuery + query.String(), params...)

    if err != nil {
       p.LastError = err
       if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
       }
        items := make([]{{name}}, 0)
        return items
    }

    defer rows.Close()

    return p.ReadRows(rows)
}

{{range _, f := funcs}}
{{if f.Kind == "Get" || f.Kind == "Find" || f.Kind == "Count"}}func (p *{{name}}Manager) {{f.Name}}({{range f.Wheres}}{{.Param}} {{.Type}}, {{end}}args ...interface{}) {{if f.Kind == "Get"}}*{{name}}{{else if f.Kind == "Find"}}[]{{name}}{{else}}int{{end}} {
    rets := make([]interface{}, 0)
    rets = append(rets, args...)

    {{range f.Wheres}}{{if .Check != ""}}if {{.Check|raw}} {
        rets = append(rets, Where{Column:"{{.Key}}", Value:{{.Param}}, Compare:"{{.Compare}}"})
    }{{else}}rets = append(rets, Where{Column:"{{.Key}}", Value:{{.Param}}, Compare:"{{.Compare}}"}){{end}}
    {{end}}
    {{if f.Kind == "Get"}}items := p.Find(rets)

    if len(items) > 0 {
        return &items[0]
    } else {
        return nil
    }{{else if f.Kind == "Find"}}return p.Find(rets){{else}}return p.Count(rets){{end}}
}{{end}}{{if f.Kind == "Delete"}}func (p *{{name}}Manager) {{f.Name}}({{range i, v := f.Wheres}}{{if i > 0}}, {{end}}{{v.Param}} {{v.Type}}{{end}}) error {
     if !p.Conn.IsConnect() {
        return errors.New("Connection Error")
    }

    // 조건은 Find 와 같이 WhereClause 로 만든다 (in / like 지원).
    query, params := p.MakeQuery("delete from {{tableName}} where 1=1", "", nil, []interface{}{ {{range f.Wheres}}Where{Column:"{{.Key}}", Value:{{.Param}}, Compare:"{{.Compare}}"}, {{end}} })
    _, err := p.Exec(query, params...)

    if err != nil {
       if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
       }
    }

    return err
}{{end}}{{if f.Kind == "Update"}}func (p *{{name}}Manager) {{f.Name}}({{range i, v := f.Wheres}}{{if i > 0}}, {{end}}{{v.Param}} {{v.Type}}{{end}}) error {
     if !p.Conn.IsConnect() {
        return errors.New("Connection Error")
    }

    query := "update {{tableName}} set {{range i, v := f.Wheres}}{{if v.Compare == "column"}}{{if i > 0}}, {{end}}{{prefix}}_{{v.Key}} = ?{{end}}{{end}} where 1=1{{range i, v := f.Wheres}}{{if v.Compare == "where"}} and {{prefix}}_{{v.Key}} = ?{{end}}{{end}}"
	_, err := p.Exec(query{{range f.Wheres}}, {{if .Compare == "column"}}{{writeParam(.Column, .Param)|raw}}{{else}}{{.Param}}{{end}}{{end}})

    if err != nil {
       if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
       }
    }

    return err    
}{{end}}
{{end}}
{{sumflag := false}}{{range items}}{{if .Name == "Price" || .Name == "Totalprice" || .Name == "Count" || .Name == "Score"}}{{sumflag = true}}{{end}}{{end}}
{{if sumflag == true}}func (p *{{name}}Manager) Sum(args []interface{}) *{{name}} {
    if !p.Conn.IsConnect() {
        var item {{name}}
        return &item
    }

    var params []interface{}

    {{flag := false}}
    query := "select {{range items}}{{if .Name == "Price" || .Name == "Totalprice" || .Name == "Count" || .Name == "Score"}}{{if flag == true}}, {{end}}ifnull(sum({{.Column}}), 0){{flag = true}}{{end}}{{end}} from {{tableName}}"

    if p.Index != "" {
        query = query + " use index(" + p.Index + ") "
    }

    query += " where 1=1 "

    page := 0
    pagesize := 0
    orderby := ""
    
    for _, arg := range args {
        switch v := arg.(type) {
        case PagingType:
            item := v
            page = item.Page
            pagesize = item.Pagesize
        case OrderingType:
            item := v
            orderby = item.Order
        case LimitType:
            item := v
            page = 1
            pagesize = item.Limit
        case OptionType:
            item := v
            if item.Limit > 0 {
                page = 1
                pagesize = item.Limit
            } else {
                page = item.Page
                pagesize = item.Pagesize                
            }
            orderby = item.Order
        case Where:
            item := v
            if item.Compare == "in" {
                // 예전 생성 코드와 같이 이 함수의 in 조건은 항상 기본 키 컬럼에 건다.
                item.Column = "{{orderKey}}"
            }
            clause, whereParams := WhereClause("{{prefix}}_", item, nil)
            query += clause
            params = append(params, whereParams...)
        case Custom:
             item := v

             query += " and " + item.Query
             params = append(params, item.Params...)
        }        
    }
    
    startpage := (page - 1) * pagesize
    
    if page > 0 && pagesize > 0 {
        if orderby == "" {
            orderby = "{{prefix}}_{{orderKey}} desc"
        } else {
            orderby = p.FixOrder(orderby)
        }
        query += " order by " + orderby
        //if config.Database == "mysql" {
            query += " limit ? offset ?"
            params = append(params, pagesize)
            params = append(params, startpage)
            /*
        } else if config.Database == "mssql" || config.Database == "sqlserver" {
            query += "OFFSET ? ROWS FETCH NEXT ? ROWS ONLY"
            params = append(params, startpage)
            params = append(params, pagesize)
        }
        */
    } else {
        if orderby == "" {
            orderby = "{{prefix}}_{{orderKey}}"
        } else {
            orderby = p.FixOrder(orderby)
        }
        query += " order by " + orderby
    }

    rows, err := p.Query(query, params...)

    var item {{name}}
    
    if err != nil {
        if p.Log {
            log.Error().Str("error", err.Error()).Msg("SQL")
        }
        return &item
    }

    defer rows.Close()

    if rows.Next() {
        {{flag = false}}
        rows.Scan({{range items}}{{if .Name == "Price" || .Name == "Totalprice" || .Name == "Count" || .Name == "Score"}}{{if flag == true}},{{end}}&item.{{.Name}}{{flag = true}}{{end}}{{end}})        
    }

    return &item        
}{{end}}

func (p *{{name}}Manager) GroupBy(name string, args []interface{}) []Groupby {
    if !p.Conn.IsConnect() {
        var items []Groupby
        return items
    }

    // name 은 select 절에 그대로 들어가므로 식별자 형식만 허용한다.
    if !ValidColumn(name) {
        var items []Groupby
        return items
    }

    var params []interface{}
    baseQuery := p.GetQueryGroup(name)
    var query strings.Builder
    pos := 1

    for _, arg := range args {
        switch v := arg.(type) {
        case Where:
            clause, whereParams := WhereClause("{{prefix}}_", v, &pos)
            query.WriteString(clause)
            params = append(params, whereParams...)
        case Custom:
             item := v

            query.WriteString(" and ")
            query.WriteString(item.Query)
            params = append(params, item.Params...)
        case Base:
             item := v

             baseQuery = item.Query
        }
    }
    
    query.WriteString(" group by {{prefix}}_")
    query.WriteString(name)

    rows, err := p.Query(baseQuery + query.String(), params...)

    if err != nil {
       if p.Log {
          log.Error().Str("error", err.Error()).Msg("SQL")
       }
        var items []Groupby
        return items
    }

    defer rows.Close()

    var items []Groupby

    for rows.Next() {
        var item Groupby
        err := rows.Scan(&item.Value, &item.Count)
        if err != nil {
           if p.Log {
                log.Error().Str("error", err.Error()).Msg("SQL")
           }
           break
        }

        items = append(items, item)
    }

    return items
}
