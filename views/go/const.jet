package {{constClause}}

type Column int

const (
    _ Column = iota
    {{range items}}
    Column{{.Name}}{{end}}
)

type Params struct {
    Column Column
    Value interface{}
}

{{range consts}}
type {{.Name}} int

const (
    _ {{.Name}}  = iota
{{range .Items}}    {{.Ident}}
{{end}})

var {{.Name}}s = []string{ {{range i, v := .Labels}}{{if i > 0}}, {{end}}{{v|raw}}{{end}} }
{{end}}

{{range consts}}
func Get{{.Name}}(value {{.Name}}) string {
    i := int(value)
    if i <= 0 || i >= len({{.Name}}s) {
        return ""
    }

    return {{.Name}}s[i]
}

func Find{{.Name}}(value string) {{.Name}} {
    for i := 1; i < len({{.Name}}s); i++ {
        if {{.Name}}s[i] == value {
            return {{.Name}}(i)
        }
    }

    return 0
}

func Convert{{.Name}}(value []int) []{{.Name}} {
     items := make([]{{.Name}}, 0)

     for _, item := range value {
         items = append(items, {{.Name}}(item))
     }

     return items
}
{{end}}
