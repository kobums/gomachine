// Auto-generated by buildtool-model. 모든 테이블이 함께 쓰는 파일이라 테이블마다 덮어쓴다 (직접 고치지 않는다).
//
// Go 와 Spring 백엔드의 응답 모양이 달라서 여기서 같은 모양으로 맞춘다.
//   목록  GET /{table}        Go {items, total?, code}     Spring {content, page, size, pagesize, totalElements, ...}
//   단건  GET /{table}/:id    Go {item, code}              Spring 엔티티 그대로
//   개수  GET /{table}/count  Go {total, count, code}      Spring {count}
//   검색  GET /{table}/search/{field}  Go {items, code}    Spring 배열
//   에러  Go 는 HTTP 200 + code ("error", "auth error"), 잘못된 요청은 400 + code "bad request".
//         Spring 은 HTTP 상태 코드 (api 래퍼가 던진다). Go 의 code 에러는 ApiError 로 던진다.

export interface SpringPage<T> {
  content: T[];
  page: number;
  size: number;
  pagesize: number;
  totalElements: number;
  totalPages: number;
  first: boolean;
  last: boolean;
  empty: boolean;
}

export interface GoList<T> {
  items?: T[] | null;
  total?: number;
  code?: string;
}

export interface GoItem<T> {
  item?: T | null;
  code?: string;
}

/** 목록 응답: Spring 페이지 또는 Go {items, total}. */
export type ListResponse<T> = SpringPage<T> | GoList<T>;

/** 단건 응답: Spring 은 엔티티 그대로, Go 는 {item}. */
export type ItemResponse<T> = T | GoItem<T>;

/** 개수 응답: Spring {count}, Go {total, count}. */
export interface CountResponse {
  count?: number;
  total?: number;
  code?: string;
}

/** 두 백엔드 공통으로 맞춘 목록 한 페이지. total 은 전체 행 수 (Go 에서 page 없이 부르면 items 길이). */
export interface Page<T> {
  items: T[];
  total: number;
  page?: number;
  pagesize?: number;
}

/**
 * 엔티티 모양 힌트. 엔티티에 item / code 필드가 있으면(strict) Go 래퍼와 헷갈리므로,
 * 기본 키(probe) 필드가 있는 응답은 엔티티로 본다.
 */
export interface EntityShape {
  strict: boolean;
  probe: string;
}

/** Go 백엔드가 HTTP 200 본문의 code 로 알리는 에러. */
export const GO_ERROR_CODES: readonly string[] = ['error', 'auth error', 'bad request'];

export class ApiError extends Error {
  readonly code: string;
  readonly detail: unknown;

  constructor(code: string, detail?: unknown) {
    super(`api error: ${code}`);
    this.name = 'ApiError';
    this.code = code;
    this.detail = detail;
  }
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null && !Array.isArray(value);
}

function looksLikeEntity(data: Record<string, unknown>, shape?: EntityShape): boolean {
  return !!shape && shape.strict && shape.probe !== '' && Object.prototype.hasOwnProperty.call(data, shape.probe);
}

/** Go 의 code 에러면 ApiError 를 던진다. */
export function checkGoError(data: unknown, shape?: EntityShape): void {
  if (!isRecord(data) || looksLikeEntity(data, shape)) {
    return;
  }
  const code = data.code;
  if (typeof code === 'string' && GO_ERROR_CODES.includes(code)) {
    throw new ApiError(code, data.error);
  }
}

/** 배열(Spring 검색), {items}(Go), {content}(Spring 목록) 어느 것이든 배열로 바꾼다. */
export function toList<T>(data: unknown): T[] {
  checkGoError(data);
  if (Array.isArray(data)) {
    return data as T[];
  }
  if (isRecord(data)) {
    const list = data.content ?? data.items;
    if (Array.isArray(list)) {
      return list as T[];
    }
  }
  return [];
}

function numberOf(value: unknown): number | undefined {
  if (typeof value === 'number') {
    return value;
  }
  if (typeof value === 'string' && value.trim() !== '' && !Number.isNaN(Number(value))) {
    return Number(value);
  }
  return undefined;
}

/** 목록 응답을 Page 로 바꾼다. total = totalElements ?? total ?? items 길이. */
export function toPage<T>(data: unknown): Page<T> {
  const items = toList<T>(data);
  const ret: Page<T> = { items, total: items.length };
  if (isRecord(data)) {
    ret.total = numberOf(data.totalElements) ?? numberOf(data.total) ?? items.length;
    const page = numberOf(data.page);
    const pagesize = numberOf(data.pagesize) ?? numberOf(data.size);
    if (page !== undefined) {
      ret.page = page;
    }
    if (pagesize !== undefined) {
      ret.pagesize = pagesize;
    }
  }
  return ret;
}

/** 단건 응답을 엔티티로 바꾼다. Go {item: null} 이나 빈 응답은 null. */
export function toItem<T>(data: unknown, shape: EntityShape): T | null {
  checkGoError(data, shape);
  if (!isRecord(data)) {
    return null;
  }
  if (!looksLikeEntity(data, shape) && Object.prototype.hasOwnProperty.call(data, 'item')) {
    const item = data.item;
    return isRecord(item) ? (item as T) : null;
  }
  return data as T;
}

/** 개수 응답을 숫자로 바꾼다 (count ?? total). */
export function toCount(data: unknown): number {
  checkGoError(data);
  if (!isRecord(data)) {
    return numberOf(data) ?? 0;
  }
  return numberOf(data.count) ?? numberOf(data.total) ?? 0;
}

/**
 * 생성/수정 응답. Spring 은 저장한 엔티티 전체, Go 는 생성이면 {id}, 수정이면 빈 객체다.
 * 그래서 Partial 이다. 전체 값이 필요하면 get 으로 다시 읽는다.
 */
export function toSaved<T>(data: unknown, shape: EntityShape): Partial<T> {
  checkGoError(data, shape);
  if (!isRecord(data)) {
    return {};
  }
  if (looksLikeEntity(data, shape) || !Object.prototype.hasOwnProperty.call(data, 'code')) {
    if (!looksLikeEntity(data, shape) && isRecord(data.item)) {
      return data.item as Partial<T>;
    }
    return data as Partial<T>;
  }
  // Go 결과: code / error 를 뺀 나머지 (생성이면 id)
  const ret: Record<string, unknown> = {};
  for (const [key, value] of Object.entries(data)) {
    if (key !== 'code' && key !== 'error') {
      ret[key] = value;
    }
  }
  return ret as Partial<T>;
}

/** 생성(batch) 응답. Spring 은 저장한 엔티티 배열, Go 는 {code} 뿐이라 빈 배열이다. */
export function toSavedList<T>(data: unknown): Partial<T>[] {
  checkGoError(data);
  return Array.isArray(data) ? (data as Partial<T>[]) : [];
}

/** 삭제 응답. 에러만 확인한다 (Spring {success}, Go {code}). */
export function toDone(data: unknown): void {
  checkGoError(data);
}
