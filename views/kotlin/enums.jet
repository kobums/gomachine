package {{.BasePackage}}.enums.{{.ModelVar|raw}}

import com.fasterxml.jackson.annotation.JsonCreator
import com.fasterxml.jackson.annotation.JsonValue
import jakarta.persistence.AttributeConverter
import jakarta.persistence.Converter

{{range .Enums}}
// 코드(code)는 model.json map data 배열 안의 위치다 (Go / TypeScript / Dart 와 같은 값).
// DB 와 JSON 에는 코드(숫자)로 저장/전송한다.
enum class {{.Name}}(@get:JsonValue val code: Int, val label: String) {
{{if .HasNone}}    NONE(0, ""),
{{end}}{{range .Items}}    {{.Ident|raw}}({{.Code}}, {{.Quote|raw}}),
{{end}};

    companion object {
        @JvmStatic
        @JsonCreator
        fun fromCode(code: Int): {{.Name}}? = values().firstOrNull { it.code == code }

        fun getDisplayName(value: {{.Name}}?): String = value?.label ?: ""

        // 표시 이름으로 찾는다.
        fun fromString(value: String): {{.Name}}? = values().firstOrNull { it.label == value }
    }
}

// {{.Name}} 을 DB 에 코드(Int)로 저장한다. 엔티티 필드에 @Convert 로 붙인다.
@Converter
class {{.Name}}Converter : AttributeConverter<{{.Name}}, Int> {
    override fun convertToDatabaseColumn(attribute: {{.Name}}?): Int? = attribute?.code

    override fun convertToEntityAttribute(dbData: Int?): {{.Name}}? = dbData?.let { {{.Name}}.fromCode(it) }
}

{{end}}
