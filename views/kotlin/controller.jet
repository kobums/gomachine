    @PutMapping("/{id}")
    fun update{{.ModelName}}(
        @PathVariable id: Long,
        @RequestBody request: {{.ModelName}}UpdateRequest
    ): ResponseEntity<{{.ModelName}}Response> {
{{if len(sessions) > 0}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build()
        if (ownedOrNull(id) == null) return ResponseEntity.notFound().build()
