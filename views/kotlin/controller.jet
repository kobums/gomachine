{{if not .IsView}}
    // 실패하면 원인을 로그로 남기고 에러 내용을 돌려준다 (제약 조건 위반, 이미 있는 기본 키는 409).
    private fun createError(e: Exception): ResponseEntity<*> {
        return if (e is DataIntegrityViolationException) {
            LOG.warn("create {{.ModelName}} failed: {}", e.mostSpecificCause.message)
            ResponseEntity.status(HttpStatus.CONFLICT).body(mapOf("error" to "constraint violation"))
        } else {
            LOG.error("create {{.ModelName}} failed", e)
            ResponseEntity.badRequest().body(mapOf("error" to "create failed", "reason" to e.javaClass.simpleName))
        }
    }

    @PostMapping
    fun create{{.ModelName}}(@RequestBody _request: {{.ModelName}}CreateRequest): ResponseEntity<*> {
{{if login && not .IsUser}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build<Any>()
{{end}}        return try {
            val _res = _service.create({{if owner && not .IsUser}}withSession(_request){{else}}_request{{end}})
            ResponseEntity.ok(toResponse(_res))
        } catch (e: Exception) {
            createError(e)
        }
    }

    @PostMapping("/batch")
    fun create{{.ModelName}}s(@RequestBody _requests: List<{{.ModelName}}CreateRequest>): ResponseEntity<*> {
        if (_requests.size > MAX_BATCH) return ResponseEntity.badRequest().body(mapOf("code" to "bad request"))
{{if login}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build<Any>()
{{end}}        return try {
            val _res = _service.createBatch({{if owner && not .IsUser}}_requests.map { withSession(it) }{{else}}_requests{{end}})
            ResponseEntity.ok(_res.map { toResponse(it) })
        } catch (e: Exception) {
            createError(e)
        }
    }
{{if .HasIdRoutes}}
    // PUT 도 PATCH 와 같이 보낸 필드만 바꾼다 (빠진/null 필드는 기존 값 유지, createddate 는 바꾸지 않는다).
    @PutMapping("/{id}")
    fun update{{.ModelName}}(
        @PathVariable("id") _id: {{pk.QualType}},
        @RequestBody _request: {{.ModelName}}UpdateRequest
    ): ResponseEntity<{{.ModelName}}Response> {
{{if login}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build()
{{end}}{{if guard}}        if (_service.findById(_id)?.takeIf { canWrite(it) } == null) return ResponseEntity.notFound().build()
        // 세션 컬럼은 클라이언트 값 대신 세션 값으로 고정한다.
{{end}}        val _updated = _request.copy({{pk.Field|raw}} = _id{{range sessions}}{{if not .IsPrimaryKey}}, {{.RequestField|raw}} = _sessionProvider.currentValue("{{.Key}}")!!{{.Convert}}{{end}}{{end}})
        val _res = _service.update(_updated)
        return if (_res != null) {
            ResponseEntity.ok(toResponse(_res))
        } else {
            ResponseEntity.notFound().build()
        }
    }

    @PatchMapping("/{id}")
    fun patch{{.ModelName}}(
        @PathVariable("id") _id: {{pk.QualType}},
        @RequestBody _request: {{.ModelName}}PatchRequest
    ): ResponseEntity<{{.ModelName}}Response> {
{{if login}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build()
{{end}}{{if guard}}        if (_service.findById(_id)?.takeIf { canWrite(it) } == null) return ResponseEntity.notFound().build()
        // 세션 컬럼은 클라이언트 값 대신 세션 값으로 고정한다.
{{end}}        val _patch = _request.copy({{pk.Field|raw}} = _id{{range sessions}}{{if not .IsPrimaryKey}}, {{.RequestField|raw}} = _sessionProvider.currentValue("{{.Key}}")!!{{.Convert}}{{end}}{{end}})
        val _res = _service.patch(_patch)
        return if (_res != null) {
            ResponseEntity.ok(toResponse(_res))
        } else {
            ResponseEntity.notFound().build()
