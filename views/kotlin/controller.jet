        val updatedRequest = request.copy(id = id{{range sessions}}{{if not .IsPrimaryKey}}, {{.RequestField}} = sessionProvider.currentValue("{{.Key}}")!!{{.Convert}}{{end}}{{end}})
{{else}}        val updatedRequest = request.copy(id = id)
{{end}}        val res = {{.ModelName|lower}}Service.update(updatedRequest)
        return if (res != null) {
