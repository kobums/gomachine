        val patchRequest = request.copy(id = id{{range sessions}}{{if not .IsPrimaryKey}}, {{.RequestField}} = sessionProvider.currentValue("{{.Key}}")!!{{.Convert}}{{end}}{{end}})
{{else}}        val patchRequest = request.copy(id = id)
{{end}}        val res = {{.ModelName|lower}}Service.patch(patchRequest)
        return if (res != null) {
