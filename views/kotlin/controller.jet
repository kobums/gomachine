        val res = {{.ModelName|lower}}Service.findBy{{.Name}}({{.Name|lower}}).filter { isOwned(it) }
{{else}}        val res = {{.ModelName|lower}}Service.findBy{{.Name}}({{.Name|lower}})
{{end}}        return ResponseEntity.ok(res.map { toResponse(it) } )
    }
{{end}}{{end}}

    @GetMapping("/count")
    fun getCount(): ResponseEntity<Map<String, Long>> {
{{if len(sessions) > 0}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build()
        // TODO: 소유 행 수를 리포지토리 count 쿼리로 바꾸면 전체 조회를 피할 수 있다.
        val count = {{.ModelName|lower}}Service.findAll(0, Int.MAX_VALUE).content.count { isOwned(it) }.toLong()
{{else}}        val count = {{.ModelName|lower}}Service.count()
{{end}}        return ResponseEntity.ok(mapOf("count" to count))
    }

