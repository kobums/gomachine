@RestController
@RequestMapping("/api/{{.ModelName|lower}}")
class {{.ModelName}}Controller(
    private val {{.ModelName|lower}}Service: {{.ModelName}}Service{{if len(.Sessions) > 0}},
    private val sessionProvider: SessionProvider{{end}}) {
{{sessions := .Sessions}}{{modelVar := lower(.ModelName)}}
{{if len(sessions) > 0}}
    // 로그인 여부: 소유권 검사에 쓰는 세션 값이 모두 있어야 한다.
    private fun isLoggedIn(): Boolean {
{{range sessions}}        if (sessionProvider.currentValue("{{.Key}}") == null) return false
{{end}}        return true
    }

    // 소유권 검사: 행이 현재 세션 사용자 것인지 확인한다 (남의 행 조회/수정/삭제 방지).
    private fun isOwned(entity: {{.ModelName}}): Boolean {
{{range sessions}}        val {{.Key}}Value = sessionProvider.currentValue("{{.Key}}") ?: return false
        if (entity.{{.Field}} != {{.Key}}Value{{.Convert}}) return false
{{end}}        return true
    }

    private fun ownedOrNull(id: Long): {{.ModelName}}? {
        val entity = {{modelVar}}Service.findById(id) ?: return null
        return if (isOwned(entity)) entity else null
    }
{{end}}
{{if len(sessions) > 0 && .ModelName != "User"}}
    // 생성 요청의 세션 컬럼은 클라이언트 값 대신 세션 값으로 고정한다.
    private fun withSession(request: {{.ModelName}}CreateRequest): {{.ModelName}}CreateRequest {
        var ret = request
{{range sessions}}{{if not .IsPrimaryKey}}        ret = ret.copy({{.RequestField}} = sessionProvider.currentValue("{{.Key}}")!!{{.Convert}})
{{end}}{{end}}        return ret
    }
{{end}}
    private fun toResponse({{.ModelName|lower}}: {{.ModelName}}): {{.ModelName}}Response {
        return {{.ModelName}}Response.from({{.ModelName|lower}})
    }

    private fun filterByDateRange(
        value: LocalDateTime?,
        startRange: LocalDateTime?,
        endRange: LocalDateTime?
    ): Boolean {
        if (value == null) return false
        return when {
            startRange != null && endRange != null -> value in startRange..endRange
            startRange != null -> value >= startRange
            endRange != null -> value <= endRange
            else -> true
        }
    }

    @GetMapping
    fun get{{.ModelName}}s(
        @RequestParam(defaultValue = "0") page: Int,
        @RequestParam(defaultValue = "10") pagesize: Int,
{{range .Columns}}{{if .Name != "Id" && not .IsPassword}}{{if .KotlinType == "LocalDateTime"}}        @RequestParam(required = false) start{{.Name|lower}}: LocalDateTime?,
        @RequestParam(required = false) end{{.Name|lower}}: LocalDateTime?,
{{else}}        @RequestParam(required = false) {{.Name|lower}}: {{if .IsEnum}}Int?{{else}}{{.KotlinType}}?{{end}},
{{end}}{{end}}{{end}}    ): ResponseEntity<Map<String, Any>> {
{{if len(sessions) > 0}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build()
{{end}}        var results = if ({{range .Columns}}{{if .Name != "Id" && not .IsPassword}}{{if .KotlinType == "LocalDateTime"}}start{{.Name|lower}} != null || end{{.Name|lower}} != null || {{else}}{{.Name|lower}} != null || {{end}}{{end}}{{end}}false) {
            var filtered = {{.ModelName|lower}}Service.findAll(0, Int.MAX_VALUE).content
{{range .Columns}}{{if .Name != "Id" && not .IsPassword}}{{joinData := findJoinByColumn(.DBName, allJoins)}}{{if .KotlinType == "LocalDateTime"}}            if (start{{.Name|lower}} != null || end{{.Name|lower}} != null) {
                filtered = filtered.filter { filterByDateRange(it.{{.Name|lower}}, start{{.Name|lower}}, end{{.Name|lower}}) }
            }
{{else}}            if ({{.Name|lower}} != null) {
                filtered = filtered.filter { it.{{if joinData}}{{joinData.ColumnName}}Id{{else}}{{.Name|lower}}{{end}}{{if .IsEnum}}.ordinal{{end}} == {{.Name|lower}} }
            }
{{end}}{{end}}{{end}}            filtered
        } else {
            {{.ModelName|lower}}Service.findAll(0, Int.MAX_VALUE).content
        }

{{if len(sessions) > 0}}        // 현재 세션 사용자 소유 행만 돌려준다.
        results = results.filter { isOwned(it) }
{{end}}        val totalElements = results.size
        val totalPages = if (pagesize > 0) (totalElements + pagesize - 1) / pagesize else 1
        val startIndex = page * pagesize
        val endIndex = minOf(startIndex + pagesize, totalElements)

        val pagedResults = if (startIndex < totalElements) {
            results.subList(startIndex, endIndex)
        } else {
            emptyList()
        }

        val response = mapOf(
            "content" to pagedResults.map { toResponse(it) },
            "page" to page,
            "size" to pagesize,
            "totalElements" to totalElements,
            "totalPages" to totalPages,
            "first" to (page == 0),
            "last" to (page >= totalPages - 1),
            "empty" to pagedResults.isEmpty()
        )

        return ResponseEntity.ok(response)
    }

    @GetMapping("/{id}")
    fun get{{.ModelName}}(@PathVariable id: Long): ResponseEntity<{{.ModelName}}Response> {
{{if len(sessions) > 0}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build()
        val res = ownedOrNull(id)
{{else}}        val res = {{.ModelName|lower}}Service.findById(id)
{{end}}        return if (res != null) {
            ResponseEntity.ok(toResponse(res))
        } else {
            ResponseEntity.notFound().build()
        }
    }

{{range .Columns}}{{if .Name != "Id" && not .IsPassword}}
    @GetMapping("/search/{{.Name|lower}}")
