{{- sessions := .Sessions}}{{pk := .PK}}{{modelName := .ModelName}}{{login := .RequireLogin}}{{owner := len(.Sessions) > 0}}{{guard := len(.Sessions) > 0 || .SelfOnly}}
// 지역 변수 / 매개변수는 _ 로 시작한다 (컬럼 프로퍼티 이름에는 _ 가 없어서 page, sort, order 같은 컬럼과 겹치지 않는다).
// 쿼리 파라미터는 @RequestParam 에 이름을 적어 컬럼의 API 이름(JSON key)으로 받는다.
@RestController
@RequestMapping("/api/{{.UrlName}}")
class {{.ModelName}}Controller(
    private val _service: {{.ModelName}}Service{{if login}},
    private val _sessionProvider: SessionProvider{{end}}) {

    companion object {
        private val LOG = LoggerFactory.getLogger({{.ModelName}}Controller::class.java)

        // 한 번에 돌려주는 최대 행 수 (Go 백엔드와 같다).
        const val MAX_PAGE_SIZE = {{.MaxPageSize}}

        // batch 요청 한 번에 받는 최대 행 수 (넘으면 400, Go / Rust 백엔드와 같다).
        const val MAX_BATCH = 1000

        // 정렬에 쓸 수 있는 이름(소문자: 프로퍼티 / 요청 필드 / 컬럼 이름) → 엔티티 프로퍼티
        private val SORT_FIELDS = mapOf(
{{range .Sorts}}            "{{.Key}}" to "{{.Prop}}",
{{end}}        )
    }

    // 해석하지 못한 요청 파라미터 (날짜 형식 등) 는 400.
    @ExceptionHandler(InvalidParamException::class)
    fun handleInvalidParam(e: InvalidParamException): ResponseEntity<Map<String, String>> {
        return ResponseEntity.badRequest().body(mapOf("code" to "bad request", "error" to (e.message ?: "invalid parameter")))
    }
{{if login}}
    // 로그인 여부 (auth=jwt): 현재 사용자와 소유권 검사에 쓰는 세션 값이 모두 있어야 한다.
    private fun isLoggedIn(): Boolean {
        if (_sessionProvider.currentUserId() == null) return false
{{range sessions}}        if (_sessionProvider.currentValue("{{.Key}}") == null) return false
{{end}}        return true
    }
{{end}}{{if owner}}
    // 소유권 검사: 행이 현재 세션 사용자 것인지 확인한다 (남의 행 조회/수정/삭제 방지).
    private fun isOwned(_entity: {{.ModelName}}): Boolean {
{{range i, s := sessions}}        val _s{{i}} = _sessionProvider.currentValue("{{s.Key}}") ?: return false
        if (_entity.{{s.Field|raw}} != _s{{i}}{{s.Convert}}) return false
{{end}}        return true
    }

    // 현재 세션 사용자 소유 행만 (목록 / 개수 / 검색 조건)
    private fun ownerSpec(): Specification<{{.ModelName}}> {
        return Specification { _root, _, _cb ->
            val _predicates = mutableListOf<Predicate>()
{{range i, s := sessions}}            val _s{{i}} = _sessionProvider.currentValue("{{s.Key}}")
            _predicates.add(if (_s{{i}} == null) _cb.disjunction() else _cb.equal(_root.get<Any>("{{s.Prop}}"), _s{{i}}{{s.Convert}}))
{{end}}            _cb.and(*_predicates.toTypedArray())
        }
    }
{{end}}{{if .SelfOnly}}
    // 회원 정보는 본인만 수정/삭제할 수 있다 (Go 와 같다).
    private fun isSelf(_entity: {{.ModelName}}): Boolean {
        val _uid = _sessionProvider.currentUserId() ?: return false
        return _entity.{{pk.EntityField|raw}} == _uid{{.SelfConvert}}
    }
{{end}}{{if guard && not .IsView}}
    // 수정/삭제할 수 있는 행인지 (소유권{{if .SelfOnly}}, 본인{{end}}).
    private fun canWrite(_entity: {{.ModelName}}): Boolean {
        return {{if owner && .SelfOnly}}isOwned(_entity) && isSelf(_entity){{else if owner}}isOwned(_entity){{else}}isSelf(_entity){{end}}
    }
{{end}}{{if owner && not .IsView && not .IsUser}}
    // 생성 요청의 세션 컬럼은 클라이언트 값 대신 세션 값으로 고정한다.
    private fun withSession(_request: {{.ModelName}}CreateRequest): {{.ModelName}}CreateRequest {
        var _ret = _request
{{range sessions}}{{if not .IsPrimaryKey}}        _ret = _ret.copy({{.RequestField|raw}} = _sessionProvider.currentValue("{{.Key}}")!!{{.Convert}})
{{end}}{{end}}        return _ret
    }
{{end}}
    private fun toResponse(_entity: {{.ModelName}}): {{.ModelName}}Response {
        return {{.ModelName}}Response.from(_entity)
    }

    // 목록/개수 조건. 필터와 소유권 검사를 DB 쿼리(where)로 실행한다.
    private fun buildSpec(
{{range .Columns}}{{if .IsSearchable}}{{if .DateFormat == "DATE_TIME"}}        {{.StartVar}}: java.time.LocalDateTime?,
        {{.EndVar}}: java.time.LocalDateTime?,
{{else if .DateFormat == "DATE"}}        {{.StartVar}}: java.time.LocalDate?,
        {{.EndVar}}: java.time.LocalDate?,
{{else}}        {{.Field|raw}}: {{if .IsEnum}}Int?{{else}}{{.KotlinType}}?{{end}},
{{end}}{{end}}{{end}}    ): Specification<{{.ModelName}}> {
        val _filter = Specification<{{.ModelName}}> { _root, _, _cb ->
            val _predicates = mutableListOf<Predicate>()
{{range .Columns}}{{if .IsSearchable}}{{if .DateFormat != ""}}{{qt := .DateFormat == "DATE_TIME" ? "java.time.LocalDateTime" : "java.time.LocalDate"}}            if ({{.StartVar}} != null) _predicates.add(_cb.greaterThanOrEqualTo(_root.get<{{qt}}>("{{.Prop}}"), {{.StartVar}}))
            if ({{.EndVar}} != null) _predicates.add(_cb.lessThanOrEqualTo(_root.get<{{qt}}>("{{.Prop}}"), {{.EndVar}}))
{{else if .IsEnum}}            if ({{.Field|raw}} != null) {
                // enum 은 코드(Int)로 받는다. 모르는 코드면 결과가 없다.
                val _value = {{.EnumType}}.fromCode({{.Field|raw}})
                _predicates.add(if (_value == null) _cb.disjunction() else _cb.equal(_root.get<{{.EnumType}}>("{{.Prop}}"), _value))
            }
{{else}}            if ({{.Field|raw}} != null) _predicates.add(_cb.equal(_root.get<Any>("{{.Prop}}"), {{.Field|raw}}))
{{end}}{{end}}{{end}}            _cb.and(*_predicates.toTypedArray())
        }
        return {{if owner}}_filter.and(ownerSpec()){{else}}_filter{{end}}
    }

    // 정렬: "createddate desc, name" 또는 "createddate,desc". 모르는 이름/방향이면 null (400).
    // 없으면 기본 키 내림차순.
    private fun parseSort(_sort: String?): Sort? {
        if (_sort.isNullOrBlank()) return Sort.by(Sort.Direction.DESC, "{{pk.Prop}}")
        val _orders = mutableListOf<Sort.Order>()
        for (_token in _sort.split(",")) {
            val _parts = _token.trim().split(Regex("\\s+")).filter { it.isNotEmpty() }
            if (_parts.isEmpty()) continue
            // "field,desc" 형식: 앞 항목의 방향
            if (_parts.size == 1 && _orders.isNotEmpty() && (_parts[0].equals("asc", true) || _parts[0].equals("desc", true))) {
                val _last = _orders.removeAt(_orders.size - 1)
                _orders.add(_last.with(if (_parts[0].equals("desc", true)) Sort.Direction.DESC else Sort.Direction.ASC))
                continue
            }
            if (_parts.size > 2) return null
            val _prop = SORT_FIELDS[_parts[0].lowercase()] ?: return null
            _orders.add(
                when (_parts.getOrNull(1)?.lowercase()) {
                    null, "asc" -> Sort.Order.asc(_prop)
                    "desc" -> Sort.Order.desc(_prop)
                    else -> return null
                }
            )
        }
        return if (_orders.isEmpty()) Sort.by(Sort.Direction.DESC, "{{pk.Prop}}") else Sort.by(_orders)
    }

    // page / pagesize 는 Go 백엔드와 같다: 둘 다 1 이상이면 그 페이지 (page 는 1 부터, pagesize 는 MAX_PAGE_SIZE 까지),
    // 없거나 0 이면 전체 행 (최대 MAX_PAGE_SIZE, 더 있으면 X-Truncated: true 헤더). 음수는 400.
    // 날짜 범위는 날짜만 보내면 그날 00:00:00 이다 (Go 와 같다).
    @GetMapping
    fun get{{.ModelName}}s(
        @RequestParam("page", required = false) _page: Int?,
        @RequestParam("pagesize", required = false) _pagesize: Int?,
        @RequestParam("sort", required = false) _sort: String?,
        @RequestParam("orderby", required = false) _orderby: String?,
{{range .Columns}}{{if .IsSearchable}}{{if .DateFormat != ""}}        @RequestParam("{{.StartParam}}", required = false) {{.StartVar}}: String?,
        @RequestParam("{{.EndParam}}", required = false) {{.EndVar}}: String?,
{{else}}        @RequestParam("{{.ParamName}}", required = false) {{.Field|raw}}: {{if .IsEnum}}Int?{{else}}{{.KotlinType}}?{{end}},
{{end}}{{end}}{{end}}    ): ResponseEntity<Map<String, Any>> {
{{if login}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build()
{{end}}        if ((_page ?: 0) < 0 || (_pagesize ?: 0) < 0) return ResponseEntity.badRequest().build()
        val _order = parseSort(_sort ?: _orderby) ?: return ResponseEntity.badRequest().build()
        val _paged = (_page ?: 0) > 0 && (_pagesize ?: 0) > 0
        val _safePage = if (_paged) _page!! else 1
        val _safeSize = if (_paged) _pagesize!!.coerceAtMost(MAX_PAGE_SIZE) else MAX_PAGE_SIZE
        val _spec = buildSpec(
{{range .Columns}}{{if .IsSearchable}}{{if .DateFormat == "DATE_TIME"}}            DateParams.dateTimeParam({{.StartVar}}, "{{.StartParam}}"), DateParams.dateTimeParam({{.EndVar}}, "{{.EndParam}}"),
{{else if .DateFormat == "DATE"}}            DateParams.dateParam({{.StartVar}}, "{{.StartParam}}"), DateParams.dateParam({{.EndVar}}, "{{.EndParam}}"),
{{else}}            {{.Field|raw}},
{{end}}{{end}}{{end}}        )
        val _result = _service.findAll(_spec, PageRequest.of(_safePage - 1, _safeSize, _order))

        val _body = mapOf(
            "content" to _result.content.map { toResponse(it) },
            "page" to _safePage,
            "size" to _safeSize,
            // Go 백엔드 / TypeScript 타입과 같은 이름 (size 와 같은 값)
            "pagesize" to _safeSize,
            "totalElements" to _result.totalElements,
            "totalPages" to _result.totalPages,
            "first" to _result.isFirst,
            "last" to _result.isLast,
            "empty" to _result.isEmpty
        )
        if (!_paged && _result.totalElements > _safeSize) {
            LOG.warn("{{.ModelName}} list without paging truncated to {} of {} rows", _safeSize, _result.totalElements)
            return ResponseEntity.ok().header("X-Truncated", "true").body(_body)
        }
        return ResponseEntity.ok(_body)
    }
{{if .HasIdRoutes}}
    @GetMapping("/{id}")
    fun get{{.ModelName}}(@PathVariable("id") _id: {{pk.QualType}}): ResponseEntity<{{.ModelName}}Response> {
{{if login}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build()
{{end}}        val _res = _service.findById(_id){{if owner}}?.takeIf { isOwned(it) }{{end}}
        return if (_res != null) {
            ResponseEntity.ok(toResponse(_res))
        } else {
            ResponseEntity.notFound().build()
        }
    }
{{end}}
{{range .Columns}}{{if .IsSearchable}}
    // 컬럼 값이 같은 행 목록 (Specification 의 = 조건{{if owner}}, 소유권 조건{{end}}).
    @GetMapping("/search/{{.SearchPath}}")
    fun get{{modelName}}By{{.Name}}(@RequestParam("{{.ParamName}}") _value: {{if .DateFormat != ""}}String{{else if .IsEnum}}Int{{else}}{{.KotlinType}}{{end}}): ResponseEntity<List<{{modelName}}Response>> {
{{if login}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build()
{{end}}{{if .IsEnum}}        // enum 은 코드(Int)로 받는다.
        val _v = {{.EnumType}}.fromCode(_value) ?: return ResponseEntity.badRequest().build()
{{else if .DateFormat == "DATE_TIME"}}        val _v = DateParams.dateTimeParam(_value, "{{.ParamName}}") ?: return ResponseEntity.badRequest().build()
{{else if .DateFormat == "DATE"}}        val _v = DateParams.dateParam(_value, "{{.ParamName}}") ?: return ResponseEntity.badRequest().build()
{{else}}        val _v = _value
{{end}}        val _spec = Specification<{{modelName}}> { _root, _, _cb -> _cb.equal(_root.get<Any>("{{.Prop}}"), _v) }
        val _res = _service.findAll({{if owner}}_spec.and(ownerSpec()){{else}}_spec{{end}})
        return ResponseEntity.ok(_res.map { toResponse(it) })
    }
{{end}}{{end}}
    // 목록과 같은 필터/소유권 조건으로 센다.
    @GetMapping("/count")
    fun getCount(
{{range .Columns}}{{if .IsSearchable}}{{if .DateFormat != ""}}        @RequestParam("{{.StartParam}}", required = false) {{.StartVar}}: String?,
        @RequestParam("{{.EndParam}}", required = false) {{.EndVar}}: String?,
{{else}}        @RequestParam("{{.ParamName}}", required = false) {{.Field|raw}}: {{if .IsEnum}}Int?{{else}}{{.KotlinType}}?{{end}},
{{end}}{{end}}{{end}}    ): ResponseEntity<Map<String, Long>> {
{{if login}}        if (!isLoggedIn()) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build()
{{end}}        val _spec = buildSpec(
{{range .Columns}}{{if .IsSearchable}}{{if .DateFormat == "DATE_TIME"}}            DateParams.dateTimeParam({{.StartVar}}, "{{.StartParam}}"), DateParams.dateTimeParam({{.EndVar}}, "{{.EndParam}}"),
{{else if .DateFormat == "DATE"}}            DateParams.dateParam({{.StartVar}}, "{{.StartParam}}"), DateParams.dateParam({{.EndVar}}, "{{.EndParam}}"),
{{else}}            {{.Field|raw}},
{{end}}{{end}}{{end}}        )
        val _count = _service.count(_spec)
        return ResponseEntity.ok(mapOf("count" to _count))
