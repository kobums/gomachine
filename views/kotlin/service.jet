        val updated = existing.copy(
{{range .Columns}}{{if not .IsPrimaryKey && not .IsProtected && not .IsCreated}}            {{.EntityField|raw}} = {{if .IsPassword}}request.{{.Field|raw}}?.takeIf { it.isNotBlank() }?.let { passwordEncoder.encode(it){{if boot4}}!!{{end}} }{{else}}request.{{.Field|raw}}{{end}} ?: existing.{{.EntityField|raw}},
{{end}}{{end}}        )
        return {{if len(.Joins) > 0}}reload({{repo}}.save(updated)){{else}}{{repo}}.save(updated){{end}}
