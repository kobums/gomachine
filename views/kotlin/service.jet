package {{.BasePackage}}.service

import {{.BasePackage}}.entity.{{.ModelName}}
{{if not .IsView}}import {{.BasePackage}}.entity.{{.ModelName}}CreateRequest
import {{.BasePackage}}.entity.{{.ModelName}}UpdateRequest
import {{.BasePackage}}.entity.{{.ModelName}}PatchRequest
{{end}}import {{.BasePackage}}.repository.{{.ModelName}}Repository
{{if len(.Joins) > 0 && not .IsView}}import jakarta.persistence.EntityManager
{{end}}import org.springframework.data.domain.Page
import org.springframework.data.domain.Pageable
