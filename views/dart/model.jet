import 'package:app/config/http.dart';
{{range items}}{{if .Type != "double" && .Type != "String" && .Type != "int" && .Type != "bool" && !isEnum(.Type, enums)}}import 'package:gym/models/{{.Type|lower}}.dart';
{{end}}{{end}}
{{range enums}}
// 코드(code)는 model.json map data 배열 안의 위치다 (Go / Kotlin / TypeScript 와 같은 값).
enum {{name}}{{.Name}} {
{{if .HasNone}}  none(0, ''),
{{end}}{{range .Data}}  {{.Key}}({{.Code}}, {{dartString(.Label)|raw}}),
{{end}};

  const {{name}}{{.Name}}(this.code, this.label);

  final int code;
  final String label;

  @override
  String toString() => label;

  static {{name}}{{.Name}} fromCode(int code) {
    return {{name}}{{.Name}}.values.firstWhere((e) => e.code == code, orElse: () => {{name}}{{.Name}}.{{.Zero}});
  }
}
{{end}}
class {{name}} {
{{range items}}  {{if isEnum(.Type, enums)}}{{name}}{{.Type}}{{else}}{{.Type}}{{end}}{{if .Nullable}}?{{end}} {{.Name|lower}};
{{end}}
  Map<String, dynamic> extra;

  {{name}}({
{{range items}}    this.{{.Name|lower}}{{if !.Nullable}} = {{if .Type == "int"}}0{{else if .Type == "double"}}0.0{{else if .Type == "bool"}}false{{else if .Type == "String"}}''{{else if isEnum(.Type, enums)}}{{name}}{{.Type}}.{{enumZero(.Type, enums)}}{{else}}{{if .Type}}{{.Type}}(){{else}}null{{end}}{{end}}{{end}},
{{end}}    this.extra = const {},
  });

  factory {{name}}.fromJson(Map<String, dynamic> json) {
    return {{name}}(
{{range items}}      {{.Name|lower}}: {{if .Type == "double"}}(json['{{jsonKey(.)}}'] as num{{if .Nullable}}?{{end}}){{if .Nullable}}?{{end}}.toDouble(){{else if .Type == "String" || .Type == "int" || .Type == "bool"}}json['{{jsonKey(.)}}'] as {{.Type}}{{if .Nullable}}?{{end}}{{else if isEnum(.Type, enums)}}{{if .Nullable}}json['{{jsonKey(.)}}'] == null ? null : {{end}}{{name}}{{.Type}}.fromCode(json['{{jsonKey(.)}}'] as int){{else}}{{.Type}}.fromJson(json['{{jsonKey(.)}}']){{end}},
{{end}}      extra: json['extra'] == null ? <String, dynamic>{} : json['extra'] as Map<String, dynamic>,
    );
  }

  Map<String, dynamic> toJson() => {
{{range items}}    '{{jsonKey(.)}}': {{if .Type == "double" || .Type == "String" || .Type == "int" || .Type == "bool"}}{{.Name|lower}}{{else if isEnum(.Type, enums)}}{{.Name|lower}}{{if .Nullable}}?{{end}}.code{{else}}{{.Name|lower}}{{if .Nullable}}?{{end}}.toJson(){{end}},
{{end}}  };

  {{name}} clone() {
    return {{name}}.fromJson(toJson());
  }
}

// Go 와 Spring 백엔드 응답을 모두 읽는다.
// 목록: Spring {content, totalElements} / Go {items, total}, 개수: Spring {count} / Go {total, count},
// 단건: Spring 엔티티 / Go {item}.
class {{name}}Manager {
  static const baseUrl = '/api/{{name|lower}}';

  // page 는 1 부터 (Go, Spring 같음).
  static Future<List<{{name}}>> find({
    int page = 1,
    int pagesize = 20,
    String? params,
  }) async {
    var result = await Http.get(baseUrl, {
      'page': page,
      'pagesize': pagesize,
    }, params);
    var list = result == null ? null : (result['content'] ?? result['items']);
    if (list == null) {
      return List<{{name}}>.empty(growable: true);
    }

    return list.map<{{name}}>((json) => {{name}}.fromJson(json)).toList();
  }

  static Future<int> count({String? params}) async {
    var result = await Http.get('$baseUrl/count', {}, params);
    var value = result == null ? null : (result['count'] ?? result['total']);
    if (value == null) {
      return 0;
    }
    if (value is num) {
      return value.toInt();
    }

    return int.tryParse(value.toString()) ?? 0;
  }

  static Future<{{name}}> get(int id) async {
    var result = await Http.get('$baseUrl/$id');
    var data = result;
    if (result is Map && result.containsKey('item'){{if hasItemKey}} && !result.containsKey('id'){{end}}) {
      data = result['item'];
    }
    if (data == null) {
      return {{name}}();
    }

    return {{name}}.fromJson(data);
  }

  static Future<int> insert({{name}} item) async {
    var result = await Http.insert(baseUrl, item.toJson());
    return result;
  }

  static update({{name}} item) async {
{{if hasId}}    await Http.put('$baseUrl/${item.id}', item.toJson());
{{else}}    await Http.put(baseUrl, item.toJson());
{{end}}  }

  static delete({{name}} item) async {
{{if hasId}}    await Http.delete('$baseUrl/${item.id}', item.toJson());
{{else}}    await Http.delete(baseUrl, item.toJson());
{{end}}  }
}
