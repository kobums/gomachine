import 'package:app/config/http.dart';
{{range items}}{{if .Type != "double" && .Type != "String" && .Type != "int" && .Type != "bool" && !isEnum(.Type, enums)}}import 'package:gym/models/{{.Type|lower}}.dart';
{{end}}{{end}}
{{range enums}}
enum {{name}}{{.Name}} {
  none(0, ''),
{{range .Data}}  {{.Key}}({{.Code}}, '{{.Label}}'),
{{end}};

  const {{name}}{{.Name}}(this.code, this.label);

  final int code;
  final String label;

  @override
  String toString() => label;

  static {{name}}{{.Name}} fromCode(int code) {
    return {{name}}{{.Name}}.values.firstWhere((e) => e.code == code, orElse: () => {{name}}{{.Name}}.none);
  }
}
{{end}}
class {{name}} {
{{range items}}  {{if .Type == "double" || .Type == "String" || .Type == "int" || .Type == "bool"}}{{.Type}} {{.Name|lower}};{{else if isEnum(.Type, enums)}}{{name}}{{.Type}} {{.Name|lower}};{{else}}{{.Type}} {{.Name|lower}};{{end}}
{{end}}
  Map<String, dynamic> extra;

  {{name}}({
{{range items}}    this.{{.Name|lower}} = {{if .Type == "int"}}0{{else if .Type == "double"}}0.0{{else if .Type == "bool"}}false{{else if .Type == "String"}}''{{else if isEnum(.Type, enums)}}{{name}}{{.Type}}.none{{else}}{{if .Type}}{{.Type}}(){{else}}null{{end}}{{end}},
{{end}}    this.extra = const {},
  });

  factory {{name}}.fromJson(Map<String, dynamic> json) {
    return {{name}}(
{{range items}}      {{.Name|lower}}: {{if .Type == "double" || .Type == "String" || .Type == "int" || .Type == "bool"}}json['{{.Name|lower}}'] as {{.Type}}{{else if isEnum(.Type, enums)}}{{name}}{{.Type}}.fromCode(json['{{.Name|lower}}'] as int){{else}}{{.Type}}.fromJson(json['{{.Name|lower}}']){{end}},
{{end}}      extra: json['extra'] == null ? <String, dynamic>{} : json['extra'] as Map<String, dynamic>,
    );
  }

  Map<String, dynamic> toJson() => {
{{range items}}    '{{.Name|lower}}': {{if .Type == "double" || .Type == "String" || .Type == "int" || .Type == "bool"}}{{.Name|lower}}{{else if isEnum(.Type, enums)}}{{.Name|lower}}.code{{else}}{{.Name|lower}}.toJson(){{end}},
{{end}}  };

  {{name}} clone() {
    return {{name}}.fromJson(toJson());
  }
}

class {{name}}Manager {
  static const baseUrl = '/api/{{name|lower}}';

  static Future<List<{{name}}>> find({
    int page = 0,
    int pagesize = 20,
    String? params,
  }) async {
    var result = await Http.get(baseUrl, {
      'page': page,
      'pagesize': pagesize,
    }, params);
    if (result == null || result['content'] == null) {
      return List<{{name}}>.empty(growable: true);
    }

    return result['content'].map<{{name}}>((json) => {{name}}.fromJson(json)).toList();
  }

  static Future<int> count({String? params}) async {
    var result = await Http.get('$baseUrl/count', {}, params);
    if (result == null || result['total'] == null) {
      return 0;
    }

    return int.parse(result['total']);
  }

  static Future<{{name}}> get(int id) async {
    var result = await Http.get('$baseUrl/$id');
    if (result == null || result['item'] == null) {
      return {{name}}();
    }

    return {{name}}.fromJson(result);
  }

  static Future<int> insert({{name}} item) async {
    var result = await Http.insert(baseUrl, item.toJson());
    return result;
  }

  static update({{name}} item) async {
    await Http.put(baseUrl, item.toJson());
  }

  static delete({{name}} item) async {
    await Http.delete(baseUrl, item.toJson());
  }
}
