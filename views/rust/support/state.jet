// @generated by gomachine - do not edit
// buildtool 이 만드는 파일이다 (다시 생성하면 덮어쓴다).
// 앱 상태와 DB 연결. 생성 핸들러는 State<MySqlPool> 로 풀만 꺼내 쓰므로, 상태를 직접 만들 때는 FromRef<내 상태> for MySqlPool 만 구현하면 된다.
// 풀은 반드시 connect / connect_lazy / connect_options 로 만든다 (직접 만들면 .timezone(None) 을 넣는다):
// sqlx 기본값은 세션 time_zone 을 '+00:00' 으로 바꿔서 TIMESTAMP 컬럼이 서버 시간대(Go 백엔드가 보는 값)와 달라진다.

use axum::extract::FromRef;
use sqlx::MySqlPool;
use sqlx::mysql::{MySqlConnectOptions, MySqlPoolOptions};

#[derive(Clone)]
pub struct AppState {
    pub pool: MySqlPool,
}

impl AppState {
    pub fn new(pool: MySqlPool) -> Self {
        AppState { pool }
    }
}

impl FromRef<AppState> for MySqlPool {
    fn from_ref(state: &AppState) -> Self {
        state.pool.clone()
    }
}

/// DATABASE_URL 로 연결 옵션을 만든다. 세션 time_zone 을 바꾸지 않는다 (timezone(None): 서버 시간대, Go 와 같다).
/// URL 에 timezone / time-zone 파라미터를 적으면 그 값을 쓴다.
pub fn connect_options(url: &str) -> Result<MySqlConnectOptions, sqlx::Error> {
    let opts: MySqlConnectOptions = url.parse()?;
    if url_has_timezone(url) { Ok(opts) } else { Ok(opts.timezone(None)) }
}

/// connect_options 로 풀을 만들고 연결해 본다.
pub async fn connect(url: &str, max_connections: u32) -> Result<MySqlPool, sqlx::Error> {
    MySqlPoolOptions::new().max_connections(max_connections).connect_with(connect_options(url)?).await
}

/// connect_options 로 풀을 만든다 (처음 쓸 때 연결한다).
pub fn connect_lazy(url: &str, max_connections: u32) -> Result<MySqlPool, sqlx::Error> {
    Ok(MySqlPoolOptions::new().max_connections(max_connections).connect_lazy_with(connect_options(url)?))
}

// URL 쿼리에 timezone / time-zone 파라미터가 있는지
fn url_has_timezone(url: &str) -> bool {
    url.split_once('?').is_some_and(|(_, q)| {
        q.split('&').any(|kv| matches!(kv.split('=').next(), Some("timezone" | "time-zone")))
    })
}

#[cfg(test)]
mod tests {
    use super::*;

    // MySqlConnectOptions 는 timezone getter 가 없어서 Debug 출력으로 확인한다.
    fn tz(url: &str) -> String {
        let s = format!("{:?}", connect_options(url).unwrap());
        let i = s.find("timezone: ").expect("timezone field");
        s[i..].split(',').next().unwrap().to_string()
    }

    #[test]
    fn options_keep_server_timezone() {
        assert_eq!(tz("mysql://u:p@127.0.0.1:3306/db"), "timezone: None");
        assert_eq!(tz("mysql://u:p@127.0.0.1:3306/db?ssl-mode=disabled"), "timezone: None");
        // 직접 적은 값은 그대로
        assert_eq!(tz("mysql://u:p@127.0.0.1:3306/db?timezone=%2B09:00"), "timezone: Some(\"+09:00\")");
        assert_eq!(tz("mysql://u:p@h/db?a=1&time-zone=SYSTEM"), "timezone: Some(\"SYSTEM\")");
        // sqlx 기본값은 '+00:00' 이다 (이 기본값을 끄는 것이 connect_options 의 목적)
        let d = format!("{:?}", "mysql://u:p@h/db".parse::<MySqlConnectOptions>().unwrap());
        assert!(d.contains("timezone: Some(\"+00:00\")"), "{d}");
    }

    #[tokio::test]
    async fn lazy_pool_builds() {
        assert!(connect_lazy("mysql://u:p@127.0.0.1:1/db", 2).is_ok());
    }
}
