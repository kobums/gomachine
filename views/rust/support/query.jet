// @generated by gomachine - do not edit
// buildtool 이 만드는 파일이다 (다시 생성하면 덮어쓴다).
// 조회 조건: Go models/db.go 의 Where / Custom / Paging / Ordering 과 WhereClause 규칙을 그대로 따른다.

use std::borrow::Cow;

use sqlx::{MySql, QueryBuilder};

/// 바인딩 값. List 는 in / not in, Pair 는 between 에만 쓴다 (다른 연산자에 넘기면 " and 1=0").
#[derive(Debug, Clone, PartialEq)]
pub enum Bind {
    I32(i32),
    I64(i64),
    U32(u32),
    U64(u64),
    F64(f64),
    Bool(bool),
    Str(String),
    Bytes(Vec<u8>),
    Null,
    List(Vec<Bind>),
    Pair(Box<Bind>, Box<Bind>),
}

impl Bind {
    /// in / not in 값 목록.
    pub fn list<T: Into<Bind>>(items: impl IntoIterator<Item = T>) -> Self {
        Bind::List(items.into_iter().map(Into::into).collect())
    }

    /// between 값 (시작, 끝).
    pub fn pair(a: impl Into<Bind>, b: impl Into<Bind>) -> Self {
        Bind::Pair(Box::new(a.into()), Box::new(b.into()))
    }

    /// 자리표시자 하나에 바인딩할 수 있는 값인지 (List / Pair 가 아닌 값).
    pub fn is_scalar(&self) -> bool {
        !matches!(self, Bind::List(_) | Bind::Pair(_, _))
    }

    /// 값을 바인딩한다 (자리표시자 ? 도 같이 붙는다). List / Pair 는 바인딩하지 않고 false.
    pub fn push_bind(&self, qb: &mut QueryBuilder<MySql>) -> bool {
        match self {
            Bind::I32(v) => qb.push_bind(*v),
            Bind::I64(v) => qb.push_bind(*v),
            Bind::U32(v) => qb.push_bind(*v),
            Bind::U64(v) => qb.push_bind(*v),
            Bind::F64(v) => qb.push_bind(*v),
            Bind::Bool(v) => qb.push_bind(*v),
            Bind::Str(v) => qb.push_bind(v.clone()),
            Bind::Bytes(v) => qb.push_bind(v.clone()),
            Bind::Null => qb.push_bind(Option::<String>::None),
            Bind::List(_) | Bind::Pair(_, _) => return false,
        };
        true
    }
}

macro_rules! bind_from {
    ($($t:ty => $v:ident),* $(,)?) => {
        $(impl From<$t> for Bind {
            fn from(v: $t) -> Self {
                Bind::$v(v.into())
            }
        })*
    };
}

bind_from!(i8 => I32, i16 => I32, i32 => I32, i64 => I64, u8 => U32, u16 => U32, u32 => U32, u64 => U64, f32 => F64, f64 => F64, bool => Bool, String => Str, Vec<u8> => Bytes);

impl From<&str> for Bind {
    fn from(v: &str) -> Self {
        Bind::Str(v.to_string())
    }
}

impl From<&String> for Bind {
    fn from(v: &String) -> Self {
        Bind::Str(v.clone())
    }
}

impl<T: Into<Bind>> From<Option<T>> for Bind {
    fn from(v: Option<T>) -> Self {
        v.map_or(Bind::Null, Into::into)
    }
}

/// 허용 연산자 (Go WhereClause 와 같다).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Compare {
    Eq,
    Ne,
    NeAlt,
    Lt,
    Le,
    Gt,
    Ge,
    Like,
    NotLike,
    In,
    NotIn,
    Between,
}

impl Compare {
    /// 연산자 문자열을 해석한다. 대소문자와 공백 수는 가리지 않는다 ("NOT  IN" → NotIn). 모르는 연산자면 None.
    pub fn parse(op: &str) -> Option<Self> {
        let op = op.split_whitespace().collect::<Vec<_>>().join(" ").to_ascii_lowercase();
        Some(match op.as_str() {
            "=" => Compare::Eq,
            "!=" => Compare::Ne,
            "<>" => Compare::NeAlt,
            "<" => Compare::Lt,
            "<=" => Compare::Le,
            ">" => Compare::Gt,
            ">=" => Compare::Ge,
            "like" => Compare::Like,
            "not like" => Compare::NotLike,
            "in" => Compare::In,
            "not in" => Compare::NotIn,
            "between" => Compare::Between,
            _ => return None,
        })
    }

    /// SQL 에 넣는 연산자.
    pub fn as_sql(self) -> &'static str {
        match self {
            Compare::Eq => "=",
            Compare::Ne => "!=",
            Compare::NeAlt => "<>",
            Compare::Lt => "<",
            Compare::Le => "<=",
            Compare::Gt => ">",
            Compare::Ge => ">=",
            Compare::Like => "like",
            Compare::NotLike => "not like",
            Compare::In => "in",
            Compare::NotIn => "not in",
            Compare::Between => "between",
        }
    }
}

/// 컬럼 조건 (Go models.Where). column 은 접두사 뺀 이름이고 SQL 에는 prefix + column 으로 들어간다.
#[derive(Debug, Clone, PartialEq)]
pub struct Where {
    pub column: Cow<'static, str>,
    pub value: Bind,
    pub compare: Cow<'static, str>,
}

impl Where {
    pub fn new(column: impl Into<Cow<'static, str>>, value: impl Into<Bind>, compare: impl Into<Cow<'static, str>>) -> Self {
        Where { column: column.into(), value: value.into(), compare: compare.into() }
    }

    /// 같은 값 (=) 조건.
    pub fn eq(column: impl Into<Cow<'static, str>>, value: impl Into<Bind>) -> Self {
        Where::new(column, value, "=")
    }
}

/// 원시 SQL 조건 (Go models.Custom). sql 안의 ? 에 params 를 차례로 바인딩한다. 외부 입력은 sql 에 이어붙이지 말고 params 로 넘긴다.
#[derive(Debug, Clone, PartialEq)]
pub struct Custom {
    pub sql: Cow<'static, str>,
    pub params: Vec<Bind>,
}

impl Custom {
    pub fn new(sql: impl Into<Cow<'static, str>>, params: Vec<Bind>) -> Self {
        Custom { sql: sql.into(), params }
    }
}

/// 조회 인자 (Go 의 []interface{} args).
#[derive(Debug, Clone, PartialEq)]
pub enum Arg {
    Where(Where),
    Custom(Custom),
    /// page 는 1 부터. page / pagesize 가 0 이면 전체 행.
    Paging { page: i64, pagesize: i64 },
    /// 정렬 절. SQL 에 그대로 들어가므로 검증한 값(모델 parse_order / 코드 상수)만 넘긴다.
    Ordering(String),
}

impl From<Where> for Arg {
    fn from(v: Where) -> Self {
        Arg::Where(v)
    }
}

impl From<Custom> for Arg {
    fn from(v: Custom) -> Self {
        Arg::Custom(v)
    }
}

/// apply_args 가 모은 페이지 / 정렬 인자.
#[derive(Debug, Clone, Default, PartialEq, Eq)]
pub struct Page {
    pub page: i64,
    pub pagesize: i64,
    pub order: Option<String>,
}

impl Page {
    /// LIMIT / OFFSET 값 (pagesize, (page-1)*pagesize). page 와 pagesize 가 모두 1 이상일 때만.
    /// offset 이 i64 를 넘으면 i64::MAX (빈 페이지). 핸들러는 page > MAX_PAGE 를 먼저 400 으로 막는다.
    pub fn limit_offset(&self) -> Option<(i64, i64)> {
        (self.page > 0 && self.pagesize > 0).then(|| (self.pagesize, (self.page - 1).saturating_mul(self.pagesize)))
    }
}

/// SQL 식별자인지 확인한다 (Go ValidColumn: ^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)?$).
pub fn valid_column(name: &str) -> bool {
    fn ident(s: &str) -> bool {
        let mut chars = s.chars();
        matches!(chars.next(), Some(c) if c.is_ascii_alphabetic() || c == '_') && chars.all(|c| c.is_ascii_alphanumeric() || c == '_')
    }
    match name.split_once('.') {
        Some((a, b)) => ident(a) && ident(b),
        None => ident(name),
    }
}

// 조건을 만들 수 없으면 아무 행도 고르지 않는다 (fail-closed).
fn fail_closed(qb: &mut QueryBuilder<MySql>, reason: &str, w: &Where) {
    tracing::warn!(column = %w.column, compare = %w.compare, "where rejected: {reason}");
    qb.push(" and 1=0");
}

/// Go WhereClause: " and {prefix}{column} {op} ?" 를 붙이고 값을 바인딩한다.
/// - column 이 식별자가 아니거나 연산자가 허용 목록에 없으면 " and 1=0"
/// - in / not in 은 원소마다 바인딩한다. 빈 목록이면 in 은 " and 1=0", not in 은 " and 1=1". 단일 값은 원소 하나로 본다
/// - between 은 값 두 개(Pair 또는 원소 두 개인 List)여야 한다
/// - like 는 보낸 값 그대로 쓴다 (% 를 붙이지 않는다)
pub fn push_where(qb: &mut QueryBuilder<MySql>, prefix: &str, w: &Where) {
    let Some(op) = Compare::parse(&w.compare) else {
        return fail_closed(qb, "invalid compare", w);
    };
    if !valid_column(&w.column) {
        return fail_closed(qb, "invalid column", w);
    }

    match op {
        Compare::In | Compare::NotIn => {
            let items: Vec<&Bind> = match &w.value {
                Bind::List(v) => v.iter().collect(),
                Bind::Pair(a, b) => vec![a.as_ref(), b.as_ref()],
                v => vec![v],
            };
            if items.is_empty() {
                qb.push(if op == Compare::In { " and 1=0" } else { " and 1=1" });
                return;
            }
            if !items.iter().all(|v| v.is_scalar()) {
                return fail_closed(qb, "nested list", w);
            }
            qb.push(" and ").push(prefix).push(&w.column).push(" ").push(op.as_sql()).push(" (");
            for (i, v) in items.into_iter().enumerate() {
                if i > 0 {
                    qb.push(", ");
                }
                v.push_bind(qb);
            }
            qb.push(")");
        }
        Compare::Between => {
            let (a, b) = match &w.value {
                Bind::Pair(a, b) => (a.as_ref(), b.as_ref()),
                Bind::List(v) if v.len() == 2 => (&v[0], &v[1]),
                _ => return fail_closed(qb, "between needs 2 values", w),
            };
            if !a.is_scalar() || !b.is_scalar() {
                return fail_closed(qb, "between needs 2 values", w);
            }
            qb.push(" and ").push(prefix).push(&w.column).push(" between ");
            a.push_bind(qb);
            qb.push(" and ");
            b.push_bind(qb);
        }
        _ => {
            if !w.value.is_scalar() {
                return fail_closed(qb, "list value", w);
            }
            qb.push(" and ").push(prefix).push(&w.column).push(" ").push(op.as_sql()).push(" ");
            w.value.push_bind(qb);
        }
    }
}

// sql 에서 따옴표(' " `) 밖의 ? 위치를 찾는다.
fn placeholders(sql: &str) -> Vec<usize> {
    let mut ret = Vec::new();
    let mut quote: Option<char> = None;
    let mut escaped = false;
    for (i, c) in sql.char_indices() {
        if let Some(q) = quote {
            if escaped {
                escaped = false;
            } else if c == '\\' && q != '`' {
                escaped = true;
            } else if c == q {
                quote = None;
            }
            continue;
        }
        match c {
            '\'' | '"' | '`' => quote = Some(c),
            '?' => ret.push(i),
            _ => {}
        }
    }
    ret
}

/// Go Custom: " and " + sql 을 붙이고 sql 의 ? 마다 params 를 바인딩한다.
/// ? 개수와 params 개수가 다르거나 params 에 List / Pair 가 있으면 " and 1=0".
pub fn push_custom(qb: &mut QueryBuilder<MySql>, c: &Custom) {
    let marks = placeholders(&c.sql);
    if marks.len() != c.params.len() || !c.params.iter().all(Bind::is_scalar) {
        tracing::warn!(sql = %c.sql, params = c.params.len(), placeholders = marks.len(), "custom rejected");
        qb.push(" and 1=0");
        return;
    }
    qb.push(" and ");
    let mut start = 0;
    for (pos, param) in marks.into_iter().zip(&c.params) {
        qb.push(&c.sql[start..pos]);
        param.push_bind(qb);
        start = pos + 1;
    }
    qb.push(&c.sql[start..]);
}

/// Go MakeQuery / Find 의 조건 부분: Where 와 Custom 을 붙이고, Paging / Ordering 은 모아서 돌려준다 (나중 값이 이긴다).
pub fn apply_args(qb: &mut QueryBuilder<MySql>, prefix: &str, args: &[Arg]) -> Page {
    let mut page = Page::default();
    for arg in args {
        match arg {
            Arg::Where(w) => push_where(qb, prefix, w),
            Arg::Custom(c) => push_custom(qb, c),
            Arg::Paging { page: p, pagesize } => {
                page.page = *p;
                page.pagesize = *pagesize;
            }
            Arg::Ordering(o) => page.order = Some(o.clone()),
        }
    }
    page
}

/// Go Find 의 정렬 / 페이지 부분. order 가 없으면 default_column (페이지면 desc).
/// 페이지면 " order by {order} limit ? offset ?" (pagesize, (page-1)*pagesize), 아니면 " order by {order}".
/// order 는 SQL 에 그대로 들어가므로 검증한 값만 넘긴다.
pub fn push_order_page(qb: &mut QueryBuilder<MySql>, page: &Page, default_column: &str) {
    let paged = page.limit_offset();
    let order = match page.order.as_deref().map(str::trim) {
        Some(o) if !o.is_empty() => o.to_string(),
        _ if paged.is_some() => format!("{default_column} desc"),
        _ => default_column.to_string(),
    };
    qb.push(" order by ").push(order);
    if let Some((limit, offset)) = paged {
        qb.push(" limit ").push_bind(limit).push(" offset ").push_bind(offset);
    }
}

/// 고정 SQL(생성 코드의 상수)의 ? 자리마다 values 를 차례로 바인딩한 QueryBuilder. ? 개수와 values 개수는 같아야 한다.
pub fn bound(sql: &str, values: &[Bind]) -> QueryBuilder<MySql> {
    let marks = placeholders(sql);
    debug_assert_eq!(marks.len(), values.len(), "{sql}");
    let mut qb = QueryBuilder::<MySql>::new("");
    let mut start = 0;
    for (pos, value) in marks.into_iter().zip(values) {
        qb.push(&sql[start..pos]);
        value.push_bind(&mut qb);
        start = pos + 1;
    }
    qb.push(&sql[start..]);
    qb
}

#[cfg(test)]
mod tests {
    use super::*;
    use sqlx::{Arguments, Execute};

    // (sql, 바인딩 개수)
    fn build(f: impl FnOnce(&mut QueryBuilder<MySql>)) -> (String, usize) {
        let mut qb = QueryBuilder::<MySql>::new("select * from t where 1=1");
        f(&mut qb);
        let sql = qb.sql().as_str().to_string();
        let mut query = qb.build();
        let n = query.take_arguments().unwrap().map(|a| a.len()).unwrap_or(0);
        (sql, n)
    }

    fn where_sql(column: &str, value: Bind, compare: &str) -> (String, usize) {
        let (sql, n) = build(|qb| push_where(qb, "u_", &Where::new(column.to_string(), value, compare.to_string())));
        (sql.trim_start_matches("select * from t where 1=1").to_string(), n)
    }

    #[test]
    fn scalar_operators() {
        for op in ["=", "!=", "<>", "<", "<=", ">", ">=", "like", "not like"] {
            assert_eq!(where_sql("name", "a%".into(), op), (format!(" and u_name {op} ?"), 1), "{op}");
        }
        assert_eq!(where_sql("name", "x".into(), " NOT   LIKE "), (" and u_name not like ?".into(), 1));
        assert_eq!(where_sql("j.c", 1.into(), "="), (" and u_j.c = ?".into(), 1));
        assert_eq!(where_sql("flag", Bind::Null, "="), (" and u_flag = ?".into(), 1));
    }

    #[test]
    fn in_operators() {
        assert_eq!(where_sql("id", Bind::list([1i64, 2, 3]), "in"), (" and u_id in (?, ?, ?)".into(), 3));
        assert_eq!(where_sql("id", Bind::list([1i64, 2]), "not in"), (" and u_id not in (?, ?)".into(), 2));
        assert_eq!(where_sql("id", 7i64.into(), "in"), (" and u_id in (?)".into(), 1));
        assert_eq!(where_sql("id", Bind::List(vec![]), "in"), (" and 1=0".into(), 0));
        assert_eq!(where_sql("id", Bind::List(vec![]), "not in"), (" and 1=1".into(), 0));
        assert_eq!(where_sql("id", Bind::List(vec![Bind::list([1])]), "in"), (" and 1=0".into(), 0));
    }

    #[test]
    fn between() {
        let range = Bind::pair("2024-01-01", "2024-02-01");
        assert_eq!(where_sql("date", range, "between"), (" and u_date between ? and ?".into(), 2));
        assert_eq!(where_sql("date", Bind::list(["a", "b"]), "between"), (" and u_date between ? and ?".into(), 2));
        assert_eq!(where_sql("date", Bind::list(["a"]), "between"), (" and 1=0".into(), 0));
        assert_eq!(where_sql("date", "a".into(), "between"), (" and 1=0".into(), 0));
    }

    #[test]
    fn fail_closed_rules() {
        for column in ["", "1a", "a b", "a;drop", "a.b.c", "a.", ".a", "a.1b", "이름"] {
            assert_eq!(where_sql(column, 1.into(), "="), (" and 1=0".into(), 0), "{column}");
        }
        for op in ["", "==", "or", "= 1 or 1=1 --", "regexp", "is"] {
            assert_eq!(where_sql("name", 1.into(), op), (" and 1=0".into(), 0), "{op}");
        }
        assert_eq!(where_sql("name", Bind::list([1, 2]), "="), (" and 1=0".into(), 0));
    }

    #[test]
    fn custom() {
        let c = Custom::new("(u_owner <> ? or u_owner is null) and u_name <> '?' and u_x = ?", vec![3i64.into(), "a".into()]);
        let (sql, n) = build(|qb| push_custom(qb, &c));
        assert_eq!(sql, "select * from t where 1=1 and (u_owner <> ? or u_owner is null) and u_name <> '?' and u_x = ?");
        assert_eq!(n, 2);
        let bad = Custom::new("u_a = ? and u_b = ?", vec![1.into()]);
        assert_eq!(build(|qb| push_custom(qb, &bad)), ("select * from t where 1=1 and 1=0".into(), 0));
        let escaped = Custom::new(r"u_a = 'it\'s ?' and u_b = ?", vec![1.into()]);
        assert_eq!(build(|qb| push_custom(qb, &escaped)).1, 1);
    }

    #[test]
    fn bound_sql() {
        let mut qb = bound("update t set a = ?, b = ? where id = ?", &["x".into(), Bind::Null, 3i64.into()]);
        assert_eq!(qb.sql().as_str(), "update t set a = ?, b = ? where id = ?");
        assert_eq!(qb.build().take_arguments().unwrap().map(|a| a.len()), Some(3));
        let qb = bound("delete from t", &[]);
        assert_eq!(qb.sql().as_str(), "delete from t");
    }

    #[test]
    fn args_and_paging() {
        let args = vec![
            Arg::Where(Where::eq("status", 1)),
            Arg::Custom(Custom::new("u_level >= ?", vec![2.into()])),
            Arg::Paging { page: 3, pagesize: 20 },
            Arg::Ordering("u_name asc".into()),
        ];
        let (sql, n) = build(|qb| {
            let page = apply_args(qb, "u_", &args);
            assert_eq!(page.limit_offset(), Some((20, 40)));
            push_order_page(qb, &page, "u_id");
        });
        assert_eq!(sql, "select * from t where 1=1 and u_status = ? and u_level >= ? order by u_name asc limit ? offset ?");
        assert_eq!(n, 4);

        let (sql, n) = build(|qb| push_order_page(qb, &Page { page: 1, pagesize: 10, order: None }, "u_id"));
        assert_eq!((sql.as_str(), n), ("select * from t where 1=1 order by u_id desc limit ? offset ?", 2));
        let (sql, n) = build(|qb| push_order_page(qb, &Page::default(), "u_id"));
        assert_eq!((sql.as_str(), n), ("select * from t where 1=1 order by u_id", 0));
        let (sql, _) = build(|qb| push_order_page(qb, &Page { page: 0, pagesize: 10, order: Some("u_name".into()) }, "u_id"));
        assert_eq!(sql, "select * from t where 1=1 order by u_name");
    }

    #[test]
    fn paging_overflow_saturates() {
        // 아주 큰 page 도 panic 없이 빈 페이지 (offset i64::MAX)
        let page = Page { page: i64::MAX, pagesize: 10000, order: None };
        assert_eq!(page.limit_offset(), Some((10000, i64::MAX)));
        let page = Page { page: i64::MAX, pagesize: 1, order: None };
        assert_eq!(page.limit_offset(), Some((1, i64::MAX - 1)));
        let (_, n) = build(|qb| push_order_page(qb, &Page { page: i64::MAX, pagesize: 20, order: None }, "u_id"));
        assert_eq!(n, 2);
    }
}
