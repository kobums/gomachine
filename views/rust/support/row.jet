// 행 읽기 헬퍼. 날짜는 DATE_FORMAT(...) 문자열, DECIMAL 은 CAST(... AS CHAR), BIT 는 (컬럼<>0), FLOAT / DOUBLE 은 CAST(... AS CHAR) 로 select 한다.
// tinyint / (bit<>0) 은 sqlx 의 bool 로 바로 읽는다 (0 이 아니면 true, Go 와 같다).

/// 읽을 때 "" 로 바꾸는 자리표시 날짜 (Go 와 같다).
pub const DATE_SENTINELS: [&str; 5] = ["0000-00-00 00:00:00", "1000-01-01 00:00:00", "9999-01-01 00:00:00", "0000-00-00", "1000-01-01"];

/// 자리표시 날짜인지.
pub fn is_sentinel_date(s: &str) -> bool {
    DATE_SENTINELS.contains(&s)
}

/// 날짜 문자열: NULL 과 자리표시 값은 "" (Go 는 NULL 을 0 값으로 읽는다).
pub fn date(v: Option<String>) -> String {
    match v {
        Some(s) if !is_sentinel_date(&s) => s,
        _ => String::new(),
    }
}

/// NULL 허용 날짜 문자열: 자리표시 값은 None.
pub fn date_opt(v: Option<String>) -> Option<String> {
    v.filter(|s| !is_sentinel_date(s))
}

/// DECIMAL / FLOAT / DOUBLE (CAST AS CHAR) 값. NULL 이나 숫자가 아니면 0.
pub fn decimal(v: Option<String>) -> f64 {
    decimal_opt(v).unwrap_or(0.0)
}

/// NULL 허용 DECIMAL / FLOAT / DOUBLE 값. 숫자가 아니면 None.
pub fn decimal_opt(v: Option<String>) -> Option<f64> {
    v.and_then(|s| s.trim().parse().ok())
}

/// enum 코드의 표시 이름 (labels[code], 모르는 코드면 "". Go Get{Enum}).
pub fn label(labels: &[&'static str], code: i32) -> &'static str {
    usize::try_from(code).ok().and_then(|i| labels.get(i)).copied().unwrap_or("")
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn sentinel_dates() {
        for s in DATE_SENTINELS {
            assert_eq!(date(Some(s.into())), "");
            assert_eq!(date_opt(Some(s.into())), None);
        }
        assert_eq!(date(None), "");
        assert_eq!(date(Some("2024-01-02 03:04:05".into())), "2024-01-02 03:04:05");
        assert_eq!(date_opt(Some("2024-01-02".into())), Some("2024-01-02".into()));
        assert_eq!(date_opt(None), None);
    }

    #[test]
    fn labels() {
        let labels = ["", "Use", "Stop"];
        assert_eq!((label(&labels, 1), label(&labels, 0), label(&labels, 3), label(&labels, -1)), ("Use", "", "", ""));
    }

    #[test]
    fn decimals() {
        assert_eq!(decimal(Some("12.50".into())), 12.5);
        assert_eq!(decimal(Some("-3".into())), -3.0);
        assert_eq!(decimal(None), 0.0);
        assert_eq!(decimal(Some("x".into())), 0.0);
        assert_eq!(decimal_opt(Some("0.10".into())), Some(0.1));
        assert_eq!(decimal_opt(None), None);
    }
}
