impl IntoResponse for ApiResult {
    fn into_response(self) -> Response {
        (StatusCode::OK, Json(Value::Object(self.0))).into_response()
    }
}

impl From<ApiResult> for Response {
    fn from(r: ApiResult) -> Self {
        r.into_response()
    }
}

/// 라우터에서 경로 / 쿼리 / 본문 파라미터를 해석하지 못했을 때: HTTP 400 {"code": "bad request"} (Go 와 같다).
pub fn bad_request() -> Response {
    (StatusCode::BAD_REQUEST, Json(ApiResult::with_code(CODE_BAD_REQUEST).0)).into_response()
}

#[cfg(test)]
mod tests {
    use super::*;
    use serde_json::json;

    #[test]
    fn result_shape() {
        let r = ApiResult::ok().set("items", vec![1, 2]).set("total", 2);
        assert_eq!(Value::Object(r.clone().into_map()), json!({"code": "ok", "items": [1, 2], "total": 2}));
        assert!(r.is_ok());
        let none: Option<i32> = None;
        assert_eq!(Value::Object(ApiResult::ok().set("item", none).into_map()), json!({"code": "ok", "item": null}));
        assert_eq!(ApiResult::auth_error().get_code(), "auth error");
        assert_eq!(ApiResult::ok().code(CODE_ERROR).get_code(), "error");
        assert_eq!(ApiResult::error().into_response().status(), StatusCode::OK);
        assert_eq!(bad_request().status(), StatusCode::BAD_REQUEST);
    }
}
