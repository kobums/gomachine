use axum::Json;
use axum::http::StatusCode;
use axum::response::{IntoResponse, Response};
use serde::Serialize;
use serde_json::{Map, Value};

use super::error::Error;

/// 핸들러 반환 타입. Err 는 로그를 남기고 HTTP 200 {"code": "error"} 다.
pub type Reply = Result<Response, Error>;

pub const CODE_OK: &str = "ok";
pub const CODE_ERROR: &str = "error";
pub const CODE_AUTH_ERROR: &str = "auth error";
pub const CODE_BAD_REQUEST: &str = "bad request";

/// 응답 JSON 객체 (기본 {"code": "ok"}). set 으로 items / total / item / count / id / error 등을 넣는다.
#[derive(Debug, Clone, PartialEq)]
pub struct ApiResult(Map<String, Value>);

impl Default for ApiResult {
    fn default() -> Self {
        ApiResult::with_code(CODE_OK)
    }
}

impl ApiResult {
    /// {"code": "ok"}
    pub fn ok() -> Self {
        ApiResult::default()
    }

    /// {"code": "error"}
    pub fn error() -> Self {
        ApiResult::with_code(CODE_ERROR)
    }

    /// {"code": "auth error"}
    pub fn auth_error() -> Self {
        ApiResult::with_code(CODE_AUTH_ERROR)
    }

    pub fn with_code(code: &str) -> Self {
        let mut map = Map::new();
        map.insert("code".into(), Value::String(code.into()));
        ApiResult(map)
    }

    /// code 를 바꾼다.
    pub fn code(mut self, code: &str) -> Self {
        self.0.insert("code".into(), Value::String(code.into()));
        self
    }

    /// 현재 code.
    pub fn get_code(&self) -> &str {
        self.0.get("code").and_then(Value::as_str).unwrap_or(CODE_OK)
    }

    pub fn is_ok(&self) -> bool {
        self.get_code() == CODE_OK
    }

    /// key 에 값을 넣는다 (Go c.Set). 직렬화하지 못하면 로그를 남기고 code 를 "error" 로 바꾼다.
    pub fn set(mut self, key: &str, value: impl Serialize) -> Self {
        self.insert(key, value);
        self
    }

    /// set 의 &mut 버전.
    pub fn insert(&mut self, key: &str, value: impl Serialize) {
        match serde_json::to_value(value) {
            Ok(v) => {
                self.0.insert(key.into(), v);
            }
            Err(err) => {
                tracing::error!(key, %err, "response serialize failed");
                self.0.insert("code".into(), Value::String(CODE_ERROR.into()));
            }
        }
    }

