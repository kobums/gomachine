// 로그인 세션 (Go controllers.Controller 의 Session). 토큰 해석은 사용자 파일 support/auth.rs 가 한다.

use std::collections::HashMap;
use std::convert::Infallible;

use axum::extract::OptionalFromRequestParts;
use axum::http::request::Parts;

/// 로그인 사용자. 핸들러는 Option<Session> 으로 받는다 (비로그인 / 잘못된 토큰이면 None, Go 의 nil Session).
#[derive(Debug, Clone, Default, PartialEq, Eq)]
pub struct Session {
    pub id: i64,
    /// 로그인 사용자 email (토큰 email claim). 없으면 빈 문자열.
    pub email: String,
    /// 관리자 확인용 (model.json adminLevel). 없으면 관리자가 아니다.
    pub level: Option<i64>,
    /// model.json session 의 key 가 id / level 이 아닐 때 쓰는 값 (key 소문자).
    pub values: HashMap<String, i64>,
}

impl Session {
    pub fn new(id: i64) -> Self {
        Session { id, ..Default::default() }
    }

    /// model.json session key 의 값 (대소문자 무시). id, level, 그 밖은 values. 없으면 0 (Go 와 같이 0 이면 auth error).
    pub fn value(&self, key: &str) -> i64 {
        match key.to_ascii_lowercase().as_str() {
            "id" => self.id,
            "level" => self.level.unwrap_or(0),
            k => self.values.get(k).copied().unwrap_or(0),
        }
    }
}

impl<S: Send + Sync> OptionalFromRequestParts<S> for Session {
    type Rejection = Infallible;

    async fn from_request_parts(parts: &mut Parts, _state: &S) -> Result<Option<Self>, Self::Rejection> {
        Ok(super::auth::session_from_parts(parts).await)
    }
}

/// 관리자인지: 세션의 level 이 admin_level 이상 (Go isAdmin). 둘 중 하나라도 없으면 false.
pub fn is_admin(session: Option<&Session>, admin_level: Option<i64>) -> bool {
    match (session.and_then(|s| s.level), admin_level) {
        (Some(level), Some(admin)) => level >= admin,
        _ => false,
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn values_and_admin() {
        let mut s = Session::new(7);
        s.values.insert("company".into(), 3);
        assert_eq!((s.value("id"), s.value("Id"), s.value("company"), s.value("level"), s.value("x")), (7, 7, 3, 0, 0));
        assert!(!is_admin(Some(&s), Some(9)));
        s.level = Some(9);
        assert!(is_admin(Some(&s), Some(9)));
        assert!(!is_admin(Some(&s), Some(10)));
        assert!(!is_admin(Some(&s), None));
        assert!(!is_admin(None, Some(1)));
    }
}
