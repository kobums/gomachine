/// 쿼리 파라미터 bool: "true" / "false" / "1" / "0" (대소문자, 앞뒤 공백 무시). 그 밖은 None (400).
pub fn parse_bool(s: &str) -> Option<bool> {
    match s.trim().to_ascii_lowercase().as_str() {
        "true" | "1" => Some(true),
        "false" | "0" => Some(false),
        _ => None,
    }
}

