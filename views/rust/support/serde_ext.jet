#[cfg(test)]
mod tests {
    use serde::{Deserialize, Serialize};
    use serde_json::json;

    #[derive(Debug, Serialize, Deserialize, PartialEq)]
    struct Item {
        #[serde(with = "super::bool_lenient")]
        flag: bool,
        #[serde(default, with = "super::opt_bool_lenient")]
        maybe: Option<bool>,
        #[serde(default, with = "super::bytes_b64")]
        data: Vec<u8>,
    }

    #[derive(Debug, Deserialize, PartialEq, Default)]
    struct Patch {
        #[serde(default, with = "super::double_option")]
        name: Option<Option<String>>,
        #[serde(default, with = "super::double_bool_lenient")]
        flag: Option<Option<bool>>,
        #[serde(default, with = "super::double_bytes_b64")]
        data: Option<Option<Vec<u8>>>,
    }

    #[test]
    fn lenient_bool() {
        for (v, want) in [(json!(true), true), (json!(false), false), (json!(1), true), (json!(0), false), (json!(2), true), (json!("true"), true), (json!("FALSE"), false), (json!("1"), true), (json!("0"), false)] {
            let item: Item = serde_json::from_value(json!({"flag": v})).unwrap();
            assert_eq!(item.flag, want, "{v}");
        }
        for v in [json!("yes"), json!(""), json!(null), json!(1.5), json!([])] {
            assert!(serde_json::from_value::<Item>(json!({"flag": v})).is_err(), "{v}");
        }
        let item: Item = serde_json::from_value(json!({"flag": 1, "maybe": null})).unwrap();
        assert_eq!(item.maybe, None);
        let item: Item = serde_json::from_value(json!({"flag": 1, "maybe": "0"})).unwrap();
        assert_eq!(item.maybe, Some(false));
        assert_eq!(serde_json::to_value(&item).unwrap()["flag"], json!(true));
        assert_eq!(super::parse_bool(" True "), Some(true));
        assert_eq!(super::parse_bool("x"), None);
    }

    #[test]
    fn base64_round_trip() {
        let item = Item { flag: true, maybe: None, data: vec![0, 1, 2, 250, 255] };
        let v = serde_json::to_value(&item).unwrap();
        // Go json.Marshal([]byte{0, 1, 2, 250, 255}) == "AAEC+v8="
        assert_eq!(v["data"], json!("AAEC+v8="));
        assert_eq!(serde_json::from_value::<Item>(v).unwrap(), item);
        let empty: Item = serde_json::from_value(json!({"flag": true, "data": null})).unwrap();
        assert!(empty.data.is_empty());
        assert!(serde_json::from_value::<Item>(json!({"flag": true, "data": "!!"})).is_err());
    }

    #[test]
    fn double_option() {
        let p: Patch = serde_json::from_value(json!({})).unwrap();
        assert_eq!(p, Patch::default());
        let p: Patch = serde_json::from_value(json!({"name": null, "flag": null, "data": null})).unwrap();
        assert_eq!(p, Patch { name: Some(None), flag: Some(None), data: Some(None) });
        let p: Patch = serde_json::from_value(json!({"name": "a", "flag": 1, "data": "AQI="})).unwrap();
        assert_eq!(p, Patch { name: Some(Some("a".into())), flag: Some(Some(true)), data: Some(Some(vec![1, 2])) });
    }
}
