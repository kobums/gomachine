// @generated by gomachine - do not edit
// buildtool 이 만드는 파일이다 (다시 생성하면 덮어쓴다).
// 비밀번호 해시: Go global/jwt.GeneratePasswd (golang.org/x/crypto/bcrypt) 와 같은 $2a$, cost 10. 같은 DB 계정을 쓴다.

use bcrypt::Version;

use super::error::Error;

/// bcrypt cost (Go 와 같다).
pub const PASSWD_COST: u32 = 10;

/// bcrypt 가 쓰는 최대 길이. Go 와 같이 더 긴 비밀번호는 해시하지 않고 에러다.
pub const MAX_PASSWD_BYTES: usize = 72;

/// 비밀번호를 $2a$10$ 해시로 만든다. 72 바이트를 넘으면 Error::PasswordTooLong (Go bcrypt.ErrPasswordTooLong).
/// CPU 를 많이 쓰므로 핸들러에서는 generate_passwd_blocking 을 쓴다.
pub fn generate_passwd(passwd: &str) -> Result<String, Error> {
    // non_truncating_* 는 72 바이트도 거부하므로 길이는 직접 확인한다 (Go 는 72 바이트까지 받는다).
    if passwd.len() > MAX_PASSWD_BYTES {
        return Err(Error::PasswordTooLong);
    }
    Ok(bcrypt::hash_with_result(passwd, PASSWD_COST)?.format_for_version(Version::TwoA))
}

/// generate_passwd 를 blocking 스레드에서 실행한다 (async 핸들러용).
pub async fn generate_passwd_blocking(passwd: String) -> Result<String, Error> {
    tokio::task::spawn_blocking(move || generate_passwd(&passwd))
        .await
        .map_err(|err| Error::Message(format!("password hash task failed: {err}")))?
}

/// 비밀번호가 해시와 맞는지 확인한다 ($2a$ / $2b$ / $2y$ 모두 된다). 해시 형식이 잘못되면 false.
/// Go bcrypt.CompareHashAndPassword 와 같이 72 바이트 뒤는 보지 않는다.
pub fn verify_passwd(passwd: &str, hash: &str) -> bool {
    bcrypt::verify(passwd, hash).unwrap_or(false)
}

#[cfg(test)]
mod tests {
    use super::*;

    // golang.org/x/crypto/bcrypt (v0.58.0) GenerateFromPassword 로 만든 해시.
    const GO_HASH: &str = "$2a$10$m0HY8Jqr.Oj7.SBKA.OeseqHUFooIrv4N6uM/jVnfbwPUwQJ1bW4i"; // "go-secret-123"
    const GO_HASH_72: &str = "$2a$04$XmMUK8jswfWU2tTNzqhI4OekwhaHDwZsspt0zqmZ72kvEVlwidj7G"; // "a" x 72, cost 4

    #[test]
    fn hash_format() {
        let h = generate_passwd("secret").unwrap();
        assert!(h.starts_with("$2a$10$"), "{h}");
        assert_eq!(h.len(), 60);
        assert!(verify_passwd("secret", &h));
        assert!(!verify_passwd("Secret", &h));
    }

    #[test]
    fn go_compat() {
        assert!(verify_passwd("go-secret-123", GO_HASH));
        assert!(!verify_passwd("go-secret-124", GO_HASH));
        // Go 처럼 72 바이트 뒤는 무시한다
        assert!(verify_passwd(&"a".repeat(72), GO_HASH_72));
        assert!(verify_passwd(&"a".repeat(73), GO_HASH_72));
        assert!(!verify_passwd("x", "not a hash"));
    }

    #[test]
    fn length_limit() {
        assert!(generate_passwd(&"a".repeat(72)).is_ok());
        assert!(matches!(generate_passwd(&"a".repeat(73)), Err(Error::PasswordTooLong)));
        // 다른 bcrypt 접두사도 확인한다
        let b = generate_passwd("pw").unwrap().replacen("$2a$", "$2b$", 1);
        assert!(verify_passwd("pw", &b));
        let y = generate_passwd("pw").unwrap().replacen("$2a$", "$2y$", 1);
        assert!(verify_passwd("pw", &y));
    }
}
