/// 서버 지역 시간 (Go 가 NOT NULL 날짜 컬럼의 빈 값을 채우는 time.Now().Format 과 같다).
pub fn local_now(fmt: &str) -> String {
    chrono::Local::now().format(fmt).to_string()
}

// UTC+9 (Asia/Seoul, 서머타임 없음)
fn seoul() -> FixedOffset {
    FixedOffset::east_opt(9 * 3600).expect("UTC+9")
}

#[cfg(test)]
mod tests {
    use super::*;
    use chrono::NaiveDateTime;

    #[test]
    fn now_format_and_zone() {
        let s = now();
        let got = NaiveDateTime::parse_from_str(&s, DATETIME_FORMAT).unwrap();
        assert_eq!(s.len(), 19, "{s}");
        let want = {{testNow|raw}};
        assert!(
