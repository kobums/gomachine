pub const DATE_FORMAT: &str = "%Y-%m-%d";
pub const TIME_FORMAT: &str = "%H:%M:%S";

/// createddate 값: timezone 의 현재 시각 "yyyy-MM-dd HH:mm:ss" (Go createdNow 와 같다).
