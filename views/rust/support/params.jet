use std::collections::HashMap;
use std::str::FromStr;

use axum::body::Bytes;
use axum::extract::rejection::{BytesRejection, PathRejection, QueryRejection};
use axum::extract::{Path, Query};
use serde_json::{Map, Value};

/// 핸들러 인자: 거부(rejection)도 받아서 Go 와 같은 400 {"code": "bad request"} 로 바꾼다.
pub type QueryArg = Result<Query<Vec<(String, String)>>, QueryRejection>;
pub type PathArg = Result<Path<HashMap<String, String>>, PathRejection>;
pub type IdArg = Result<Path<String>, PathRejection>;
pub type BodyArg = Result<Bytes, BytesRejection>;

/// 쿼리 파라미터. 해석하지 못하면 None.
pub fn query_params(arg: QueryArg) -> Option<QueryParams> {
    arg.ok().map(|Query(pairs)| QueryParams::new(pairs))
}

/// 경로 변수 이름 → 값.
pub fn path_map(arg: PathArg) -> Option<HashMap<String, String>> {
    arg.ok().map(|Path(map)| map)
}

/// 경로의 id (Go strconv.ParseInt(c.Params("id"), 10, 64)).
pub fn path_id<T: FromStr>(arg: IdArg) -> Option<T> {
    arg.ok().and_then(|Path(s)| s.parse().ok())
}

/// 경로 변수 key 를 T 로 해석한다.
pub fn path_value<T: PathValue>(map: &HashMap<String, String>, key: &str) -> Option<T> {
    map.get(key).and_then(|s| T::parse_path(s))
}

/// 경로 변수 key 를 쉼표로 나눈 T 목록으로 해석한다 (in 조건).
pub fn path_list<T: PathValue>(map: &HashMap<String, String>, key: &str) -> Option<Vec<T>> {
    map.get(key).and_then(|s| parse_list(s))
}

/// 요청 본문 바이트. 읽지 못하면 None.
pub fn body_bytes(arg: BodyArg) -> Option<Bytes> {
    arg.ok()
}

/// 쿼리 파라미터 (Go fiber c.Query: 같은 이름이 여러 번이면 첫 값, 없으면 "").
#[derive(Debug, Clone, Default)]
pub struct QueryParams(Vec<(String, String)>);

impl QueryParams {
    pub fn new(pairs: Vec<(String, String)>) -> Self {
        QueryParams(pairs)
    }

    pub fn get(&self, key: &str) -> &str {
        self.0.iter().find(|(k, _)| k == key).map(|(_, v)| v.as_str()).unwrap_or("")
    }
}

/// Go strconv.Atoi / ParseInt(s, 10, 64): 부호(+/-)와 10진 숫자만.
pub fn parse_int(s: &str) -> Option<i64> {
    s.parse().ok()
}

/// Go strconv.ParseFloat(s, 64).
pub fn parse_float(s: &str) -> Option<f64> {
    s.parse().ok()
}

/// Go strconv.ParseBool: 1 t T TRUE true True / 0 f F FALSE false False.
pub fn parse_bool(s: &str) -> Option<bool> {
    match s {
        "1" | "t" | "T" | "TRUE" | "true" | "True" => Some(true),
        "0" | "f" | "F" | "FALSE" | "false" | "False" => Some(false),
        _ => None,
    }
}

/// 경로 값을 타입으로 해석한다 (정수 / 실수는 Rust parse, bool 은 Go ParseBool).
pub trait PathValue: Sized {
    fn parse_path(s: &str) -> Option<Self>;
}

macro_rules! path_value {
    ($($t:ty),*) => {
        $(impl PathValue for $t {
            fn parse_path(s: &str) -> Option<Self> {
                s.parse().ok()
            }
        })*
    };
}

path_value!(i32, i64, u32, u64, f64, String);

impl PathValue for bool {
    fn parse_path(s: &str) -> Option<Self> {
        parse_bool(s)
    }
}

impl PathValue for Vec<u8> {
    fn parse_path(s: &str) -> Option<Self> {
        Some(s.as_bytes().to_vec())
    }
}

/// 쉼표로 나눈 경로 값 목록 (in 조건, 원소마다 앞뒤 공백 제거). 하나라도 해석하지 못하면 None.
pub fn parse_list<T: PathValue>(s: &str) -> Option<Vec<T>> {
    s.split(',').map(|e| T::parse_path(e.trim())).collect()
}

/// 목록 page 의 최댓값 (넘으면 400, Go MaxPage 와 같다).
pub const MAX_PAGE: i64 = 1_000_000_000;

/// Insertbatch / Deletebatch 한 번에 받는 최대 행 수 (넘으면 400, Go MaxBatch / Spring MAX_BATCH 와 같다).
pub const MAX_BATCH: usize = 1000;

/// page / pagesize: 없으면 0, 숫자가 아니거나 음수면 None (Go 라우터의 400).
pub fn parse_page(s: &str) -> Option<i64> {
    if s.is_empty() {
        return Some(0);
    }
    parse_int(s).filter(|v| *v >= 0)
}

/// 커스텀 UpdateXByY 본문 (Go json.Unmarshal 로 만든 map). JSON 객체가 아니면 None.
pub fn body_object(body: &[u8]) -> Option<Map<String, Value>> {
    match serde_json::from_slice(body).ok()? {
        Value::Object(map) => Some(map),
        _ => None,
    }
}

/// 본문 값 (Go 의 타입 단언: 숫자는 float64 로 받아 정수 컬럼은 소수점을 버린다). key 가 없거나 타입이 다르면 None.
/// 정수 컬럼은 Rust 타입 범위를 넘으면 (unsigned 의 음수 포함) None (400).
pub trait BodyValue: Sized {
    fn from_body(v: &Value) -> Option<Self>;
}

macro_rules! body_int {
    ($($t:ty),*) => {
        $(impl BodyValue for $t {
            #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss, clippy::cast_precision_loss)]
            fn from_body(v: &Value) -> Option<Self> {
                // 정수 JSON 값은 정확히, 소수는 Go 와 같이 버린다 (1.5 → 1)
                if let Some(i) = v.as_i64() {
                    return <$t>::try_from(i).ok();
                }
                if let Some(u) = v.as_u64() {
                    return <$t>::try_from(u).ok();
                }
                let f = v.as_f64()?.trunc();
                (f >= <$t>::MIN as f64 && f < <$t>::MAX as f64 + 1.0).then(|| f as $t)
            }
        })*
    };
}

body_int!(i32, i64, u32, u64);

impl BodyValue for f64 {
    fn from_body(v: &Value) -> Option<Self> {
        v.as_f64()
    }
}

impl BodyValue for bool {
    fn from_body(v: &Value) -> Option<Self> {
        v.as_bool()
    }
}

impl BodyValue for String {
    fn from_body(v: &Value) -> Option<Self> {
        v.as_str().map(str::to_string)
    }
}

impl BodyValue for Vec<u8> {
    fn from_body(v: &Value) -> Option<Self> {
        v.as_str().map(|s| s.as_bytes().to_vec())
    }
}

/// map[key] 를 T 로 꺼낸다.
pub fn body_value<T: BodyValue>(map: &Map<String, Value>, key: &str) -> Option<T> {
    map.get(key).and_then(T::from_body)
}

#[cfg(test)]
mod tests {
    use super::*;
    use serde_json::json;

    #[test]
    fn query_and_numbers() {
        let q = QueryParams::new(vec![("a".into(), "1".into()), ("a".into(), "2".into()), ("b".into(), "".into())]);
        assert_eq!((q.get("a"), q.get("b"), q.get("c")), ("1", "", ""));
        assert_eq!(parse_int("+12"), Some(12));
        assert_eq!(parse_int("-3"), Some(-3));
        for bad in ["", " 1", "1.0", "abc", "0x10"] {
            assert_eq!(parse_int(bad), None, "{bad}");
        }
        assert_eq!(parse_float("1.5"), Some(1.5));
        assert_eq!(parse_float("x"), None);
        for (s, want) in [("1", Some(true)), ("T", Some(true)), ("True", Some(true)), ("f", Some(false)), ("FALSE", Some(false)), ("tRuE", None), ("yes", None), ("", None)] {
            assert_eq!(parse_bool(s), want, "{s}");
        }
        assert_eq!(parse_page(""), Some(0));
        assert_eq!(parse_page("3"), Some(3));
        assert_eq!(parse_page("-1"), None);
        assert_eq!(parse_page("x"), None);
        assert_eq!(parse_page("9223372036854775807"), Some(i64::MAX));
        assert_eq!(parse_page("9223372036854775808"), None);
    }

    #[test]
    fn path_values() {
        assert_eq!(parse_list::<i64>("1, 2,3"), Some(vec![1, 2, 3]));
        assert_eq!(parse_list::<i64>("1,x"), None);
        assert_eq!(parse_list::<String>("a,b"), Some(vec!["a".to_string(), "b".to_string()]));
        assert_eq!(bool::parse_path("t"), Some(true));
        assert_eq!(i32::parse_path("99999999999"), None);
        assert_eq!(Vec::<u8>::parse_path("ab"), Some(b"ab".to_vec()));
    }

    #[test]
    fn body_values() {
        let map = body_object(br#"{"n": 1.9, "s": "x", "b": true, "z": null}"#).unwrap();
        assert_eq!(body_value::<i64>(&map, "n"), Some(1));
        assert_eq!(body_value::<f64>(&map, "n"), Some(1.9));
        assert_eq!(body_value::<String>(&map, "s"), Some("x".into()));
        assert_eq!(body_value::<bool>(&map, "b"), Some(true));
        assert_eq!(body_value::<i64>(&map, "s"), None);
        assert_eq!(body_value::<String>(&map, "z"), None);
        assert_eq!(body_value::<String>(&map, "missing"), None);
        assert!(body_object(b"[1]").is_none());
        assert!(body_object(b"null").is_none());
        assert!(body_object(b"").is_none());
        assert_eq!(body_value::<Vec<u8>>(&json!({"d": "ab"}).as_object().unwrap().clone(), "d"), Some(b"ab".to_vec()));
    }

    #[test]
    fn body_int_range() {
        let v = |s: &str| serde_json::from_str::<Value>(s).unwrap();
        // 소수는 버린다 (Go 와 같다), 음수 소수는 0 쪽으로
        assert_eq!(i32::from_body(&v("1.5")), Some(1));
        assert_eq!(i32::from_body(&v("-1.5")), Some(-1));
        assert_eq!(u32::from_body(&v("-0.5")), Some(0));
        // 타입 범위를 넘으면 None (400)
        assert_eq!(i32::from_body(&v("2147483647")), Some(i32::MAX));
        assert_eq!(i32::from_body(&v("2147483648")), None);
        assert_eq!(i32::from_body(&v("-2147483649")), None);
        assert_eq!(i32::from_body(&v("2147483647.9")), Some(i32::MAX));
        assert_eq!(i32::from_body(&v("2147483648.5")), None);
        assert_eq!(i32::from_body(&v("1e300")), None);
        assert_eq!(u32::from_body(&v("-1")), None);
        assert_eq!(u64::from_body(&v("-1")), None);
        assert_eq!(u64::from_body(&v("-1.5")), None);
        assert_eq!(u32::from_body(&v("4294967295")), Some(u32::MAX));
        assert_eq!(u32::from_body(&v("4294967296")), None);
        // 정수 JSON 값은 정확히 (f64 를 거치지 않는다)
        assert_eq!(i64::from_body(&v("9007199254740993")), Some(9007199254740993));
        assert_eq!(i64::from_body(&v("9223372036854775807")), Some(i64::MAX));
        assert_eq!(i64::from_body(&v("9223372036854775808")), None);
        assert_eq!(u64::from_body(&v("18446744073709551615")), Some(u64::MAX));
        assert_eq!(u64::from_body(&v("18446744073709551616")), None);
        assert_eq!(i64::from_body(&v("9.3e18")), None);
        assert_eq!(i64::from_body(&v("\"1\"")), None);
    }
}
