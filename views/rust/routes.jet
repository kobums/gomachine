// buildtool 이 만드는 파일이다 (다시 생성하면 덮어쓴다).
// 생성한 모든 테이블의 경로. main.rs 에서 Router::new().nest("/api", routes::routes()) 처럼 붙인다.
// 상태 S 는 MySqlPool 을 꺼낼 수 있으면 된다 (support::AppState 또는 FromRef 를 구현한 사용자 상태).

use axum::Router;
use axum::extract::FromRef;
use sqlx::MySqlPool;

pub fn routes<S>() -> Router<S>
where
    S: Clone + Send + Sync + 'static,
    MySqlPool: FromRef<S>,
{
    Router::new(){{range modules}}
        .merge(crate::handlers::{{.}}::routes()){{end}}
}
