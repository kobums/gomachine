    /// 클라이언트 정렬 문자열("createdAt desc, name")을 검증한다 (Go ParseOrder): 알려진 컬럼 + asc/desc 만 남기고 나머지 항목은 버린다.
    pub fn parse_order(orderby: &str) -> String {
        let mut ret = Vec::new();
        for part in orderby.split(',') {
            let fields: Vec<&str> = part.split_whitespace().collect();
            if fields.is_empty() || fields.len() > 2 {
                continue;
            }
            let Some(col) = Self::order_column(fields[0]) else {
                continue;
            };
            if fields.len() == 2 {
                let dir = fields[1].to_lowercase();
                if dir != "asc" && dir != "desc" {
                    continue;
                }
                ret.push(format!("{col} {dir}"));
            } else {
                ret.push(col.to_string());
            }
        }
        ret.join(", ")
