                    Value::Object(obj) => Self::from_object(obj).map(|(item, _)| item),
                    _ => None,
                })
                .collect(),
            _ => None,
        }
    }

    fn from_object(obj: Map<String, Value>) -> Option<(Self, Map<String, Value>)> {
        let mut map = Map::new();
        for (k, v) in obj {
            let Some(key) = KEYS.iter().find(|key| key.eq_ignore_ascii_case(&k)) else {
                continue;
            };
            if v.is_null() && !NULLABLE_KEYS.contains(key) {
