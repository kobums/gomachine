        rows.iter().map(Self::read_joined).collect::<Result<Vec<_>, _>>().map_err(Error::from)
    }

    pub fn count_query(args: &[Arg]) -> QueryBuilder<MySql> {
        let mut qb = QueryBuilder::<MySql>::new(COUNT);
        qb.push(" where 1=1");
        query::apply_args(&mut qb, WHERE_PREFIX, args);
        qb
    }

